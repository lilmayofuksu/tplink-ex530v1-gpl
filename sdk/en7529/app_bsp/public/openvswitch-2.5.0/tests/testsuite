ifr_run () {
    ./interface-reconfigure --root-prefix="`pwd`" --no-syslog "$@"
}

ifr_filter () {
    sed -n -e "s,`pwd`,,g" -e 's/ -- /\
    /g' -e '/^Running command:/!p' stderr
}

# Create the master directory if it doesn't already exist.
