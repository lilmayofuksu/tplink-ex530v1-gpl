mtd:
	#cp -rf $(GLOBAL_INC_DIR)/flash_layout/tc_partition.h $(BSP_APP_MTD_DIR)/
	#cp -rf $(GLOBAL_INC_DIR)/flash_layout/prolinecmd.h $(BSP_APP_MTD_DIR)/
	#cp -rf $(GLOBAL_INC_DIR)/modules/xpon_phy_global/mt7570.h  $(BSP_APP_MTD_DIR)/
	echo "Build mtd"
