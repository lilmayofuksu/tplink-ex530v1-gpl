prefix=/proj/mtk14508/workspace/branch_joyme3_0711/tclinux_phoenix/apps/public/joyme2.0/install_glib
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

gmodule_supported=true

Name: GModule
Description: Dynamic module loader for GLib
Requires: glib-2.0
Version: 2.41.1
Libs: -L${libdir} -Wl,--export-dynamic -lgmodule-2.0 -pthread
Libs.private: -ldl
Cflags: -pthread
