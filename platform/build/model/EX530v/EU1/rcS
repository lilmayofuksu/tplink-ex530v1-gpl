#!/bin/sh

################################
# Import config file
################################

. /etc/config.bba
#. /etc/config.sdk
################################
# Mount some needed partion
################################

# For pts
mkdir -p /dev/pts

# For /etc/fstab
mount -a

# For sysfs
mount -t sysfs /sys /sys

if [ -e /etc/buildDevs ]; then 
/etc/buildDevs /
fi

# for MTD_TYPE_FS
# Jffs2 type, mount misc_ro/rw partion
if [ -n "$INCLUDE_MTD_TYPE_FS" ]; then
/bin/mkdir -m 0777 -p /var/run/misc/misc_ro
/bin/mkdir -m 0777 -p /var/run/misc/misc_rw
mount -t jffs2 -r mtd:misc_ro /var/run/misc/misc_ro
mount -t jffs2 mtd:misc_rw /var/run/misc/misc_rw
fi

################################
# Create some needed folder
################################

/bin/mkdir -m 0777 -p /var/lock
/bin/mkdir -m 0777 -p /var/log
/bin/mkdir -m 0777 -p /var/run
/bin/mkdir -m 0777 -p /var/tmp
/bin/mkdir -m 0777 -p /var/tmp/wsc_upnp
/bin/mkdir -m 0777 -p /var/tmp/wsc_upnp_5G

# For samba and ntfs-3g
/bin/mkdir -m 0777 -p /var/3G
/bin/mkdir -m 0777 -p /var/usbdisk
/bin/mkdir -m 0777 -p /var/dev
/bin/mkdir -m 0777 -p /var/samba/lib
/bin/mkdir -m 0777 -p /var/samba/private
/bin/mkdir -m 0777 -p /var/samba/var/locks
cp -p /etc/passwd.bak /var/passwd

# For VPN
/bin/mkdir -m 0777 -p /var/easy-rsa
/bin/mkdir -m 0777 -p /var/easy-rsa/keys
/bin/mkdir -m 0777 -p /var/openvpn

/bin/mkdir -m 0777 -p /var/pptpd
/bin/mkdir -m 0777 -p /var/l2tp

# For https certificate
/bin/mkdir -m 0777 -p /var/https
# For dibbler (DHCPv6) work directory
/bin/mkdir -m 0777 -p /var/run/dibbler/

# For SSH
/bin/mkdir -m 0777 -p /var/tmp/dropbear


################################
# Insert kernel driver
################################
insmod /lib/modules/kmdir/kernel/drivers/scsi/scsi_mod.ko
insmod /lib/modules/kmdir/kernel/drivers/scsi/sd_mod.ko
insmod /lib/modules/kmdir/kernel/drivers/scsi/scsi_wait_scan.ko
insmod /lib/modules/kmdir/kernel/drivers/usb/core/usbcore.ko
insmod /lib/modules/kmdir/kernel/drivers/usb/storage/usb-storage.ko
insmod /lib/modules/kmdir/kernel/fs/fuse/fuse.ko
insmod /lib/modules/kmdir/kernel/fs/nls/nls_utf8.ko
insmod /lib/modules/kmdir/kernel/fs/nls/nls_cp936.ko

#netfilter modules load
insmod /lib/modules/kmdir/kernel/net/netfilter/nf_conntrack_proto_gre.ko
insmod /lib/modules/kmdir/kernel/net/netfilter/nf_conntrack_pptp.ko

################################
# Execute SDK init script
################################

. /etc/init.d/rcS.$SUPPLIER
echo "rcS.sdk init done!"

################################
# BBA private kernel module ( before rcS.model )
################################

insmod /lib/modules/ivi.ko
if [ -n "$INCLUDE_PARENTCONTROL_V2" ]; then
	insmod /lib/modules/xt_pctl.ko
fi

################################
# For 3G-dongle
################################
# linux 4.x doesn't need it
#mount -t usbfs usbfs /proc/bus/usb/

echo 1 > /proc/sys/net/ipv4/ip_forward
echo 1 > /proc/sys/net/ipv6/conf/all/forwarding

#add by Chen Zexian for increasing limit of UNIX domain socket datagram
echo 30 > /proc/sys/net/unix/max_dgram_qlen
#end by Chen Zexian

#krammer add for LAN can't continuous ping to WAN when exchenging the routing mode
#bug1126
echo 3 > /proc/sys/net/netfilter/nf_conntrack_icmp_timeout

echo 0 > /proc/sys/net/ipv4/conf/default/accept_source_route
echo 0 > /proc/sys/net/ipv4/conf/all/accept_source_route
echo 64 > /proc/sys/net/ipv4/igmp_max_memberships

#Solve the problem of ARP reply error when multi WAN connection
echo 1 > /proc/sys/net/ipv4/conf/all/arp_ignore
echo 1 > /proc/sys/net/ipv4/conf/all/arp_filter

echo 1800 > /proc/sys/net/netfilter/nf_conntrack_tcp_timeout_established
################################
# Interface operation
################################

ifconfig lo up
ifconfig lo 127.0.0.1 netmask 255.0.0.0

################################
# Execute MODEL init script
################################

. /etc/init.d/rcS.model

################################
################################
# Daemon operation
################################
#fc config --accel-mode 1

#swmdk &

echo 3 > /proc/sys/vm/drop_caches
sh /userfs/chkAndDropPer90.sh &
echo "rcS init done!"
