.PHONY: tp_fs_dev supplier_fs_dev
ifeq ($(INCLUDE_QUALCOMM)$(INCLUDE_MTK), y)
fs_dev:  supplier_fs_dev
else
fs_dev: tp_fs_dev supplier_fs_dev
endif

tp_fs_dev: fakeroot
	rm -rf $(FS_TG_PATH)/dev/*
	# For telnet
	mkdir -p $(FS_TG_PATH)/dev/pts
ifeq ($(INCLUDE_ECONET), y)
	cd $(TOOLS_PATH) && $(TOOLS_PATH)/fakeroot/fakeroot -i $(TOOLS_PATH)/fakeroot/.fake_env/$(MODEL).fake -s $(TOOLS_PATH)/fakeroot/.fake_env/$(MODEL).fake $(TOOLS_PATH)/buildDevs_econet $(FS_TG_PATH)
endif
ifeq ($(INCLUDE_QUALCOMM), y)
	cd $(TOOLS_PATH) && $(TOOLS_PATH)/fakeroot/fakeroot -i $(TOOLS_PATH)/fakeroot/.fake_env/$(MODEL).fake -s $(TOOLS_PATH)/fakeroot/.fake_env/$(MODEL).fake $(TOOLS_PATH)/buildDevs_qca $(FS_TG_PATH)
endif
ifeq ($(INCLUDE_BROADCOM), y)
	cd $(TOOLS_PATH) && $(TOOLS_PATH)/fakeroot/fakeroot -i $(TOOLS_PATH)/fakeroot/.fake_env/$(MODEL).fake -s $(TOOLS_PATH)/fakeroot/.fake_env/$(MODEL).fake $(TOOLS_PATH)/buildDevs $(FS_TG_PATH)
endif

ifeq ($(INCLUDE_ECONET), y)
fs_strip:
	dirs="$(FS_TG_PATH)/bin $(FS_TG_PATH)/sbin $(FS_TG_PATH)/usr/bin $(FS_TG_PATH)/usr/sbin $(FS_TG_PATH)/lib"; \
	for x in $$dirs; do \
		files=`find $$x -name "*" -type f`; \
		if [ "$$files" != "" ]; then \
			for y in $$files; do \
				if [ "`file -b $$y|awk '{print $$1$$2}'`" == "ELF32-bit" -o "`file -b $$y|awk '{print $$3}'`" == "archive" ]; then \
					chmod +w $$y; \
					if [ -n "$(strip $(INCLUDE_KEEP_LIB_SYMBOL))" -a "`file -b $$y|awk '{print $$4$$5}'`" == "sharedobject," ]; then \
						echo Skip stiping lib $$y; \
					else \
						$(STRIP) --strip-unneeded $$y; \
						echo Striping elf32 $$y; \
					fi; \
				fi; \
			done; \
		fi; \
	done
else
fs_strip:
	$(MAKE) fs_strip_elf32
	CURRENT_ARCH=$(KERNEL_ARCH) TOOLCHAIN_TOP= $(MAKE) fs_strip_elf64
	
fs_strip_elf32:
	dirs="$(FS_TG_PATH)/bin $(FS_TG_PATH)/sbin $(FS_TG_PATH)/usr/bin $(FS_TG_PATH)/usr/sbin $(FS_TG_PATH)/lib"; \
	for x in $$dirs; do \
		files=`find $$x -name "*" -type f`; \
		if [ "$$files" != "" ]; then \
			for y in $$files; do \
				if [ "`file -b $$y|awk '{print $$1$$2}'`" == "ELF32-bit" -o "`file -b $$y|awk '{print $$3}'`" == "archive" ]; then \
					chmod +w $$y; \
					if [ -n "$(strip $(INCLUDE_KEEP_LIB_SYMBOL))" -a "`file -b $$y|awk '{print $$4$$5}'`" == "sharedobject," ]; then \
						echo Skip stiping lib $$y; \
					else \
						$(STRIP) --strip-unneeded $$y; \
						echo Striping elf32 $$y; \
					fi; \
				fi; \
			done; \
		fi; \
	done

fs_strip_elf64:
	dirs="$(FS_TG_PATH)/bin $(FS_TG_PATH)/sbin $(FS_TG_PATH)/usr/bin $(FS_TG_PATH)/usr/sbin $(FS_TG_PATH)/lib"; \
	for x in $$dirs; do \
		files=`find $$x -name "*" -type f`; \
		if [ "$$files" != "" ]; then \
			for y in $$files; do \
				if [ "`file -b $$y|awk '{print $$1$$2}'`" == "ELF64-bit" -o "`file -b $$y|awk '{print $$3}'`" == "archive" ]; then \
					chmod +w $$y; \
					if [ -n "$(strip $(INCLUDE_KEEP_LIB_SYMBOL))" -a "`file -b $$y|awk '{print $$4$$5}'`" == "sharedobject" ]; then \
						echo Skip stiping lib $$y; \
					else \
						$(STRIP) --strip-unneeded $$y; \
						echo Striping elf64 $$y; \
					fi; \
				fi; \
			done; \
		fi; \
	done
endif	

fs_strip_post:
ifneq ($(strip $(INCLUDE_CMM_STRIP_DEBUG))$(strip $(INCLUDE_CMM_STRIP_NONE)),)
	$(MAKE) cmm_install
endif

ifeq ($(INCLUDE_MTD_TYPE_RAW1)$(INCLUDE_MTD_TYPE_RAW2), y)
ROOTFS_TYPE = fs_rootfs_squash
ifneq ($(INCLUDE_SPEC_SQUASH_BLOCK_SIZE),)
SQUASH_BLOCK_SIZE = $(INCLUDE_SQUASH_BLOCK_SIZE)
else
SQUASH_BLOCK_SIZE = $(MTD_BLOCK_SIZE)
endif
endif

ifeq ($(INCLUDE_MTD_TYPE_FS), y)
ROOTFS_TYPE = fs_rootfs_jffs
endif

# Overwrite
ifeq ($(INCLUDE_BROADCOM), y)
include $(MODEL_PATH)/fs_build
ROOTFS_TYPE = fs_bcm_rootfs
endif

ifeq ($(INCLUDE_MTK), y)
include $(MODEL_PATH)/fs_build
ROOTFS_TYPE = fs_mtk_rootfs
endif

ifeq ($(INCLUDE_SPEC_EX230), y)
include $(MODEL_PATH)/fs_build
ROOTFS_TYPE = fs_rootfs_squash_128k
endif

ifeq ($(INCLUDE_SPEC_VOICE_BOARD),y)
include $(MODEL_PATH)/fs_build
ROOTFS_TYPE = fs_rootfs_voiceboard
endif

.PHONY: $(ROOTFS_TYPE)
ifeq ($(INCLUDE_QUALCOMM), y)
fs_rootfs: fs_ipq50xx_rootfs
else
ifeq  ($(INCLUDE_QUECTEL), y)
fs_rootfs: fs_t750_rootfs
else
fs_rootfs: $(ROOTFS_TYPE)
endif
endif

fs_rootfs_jffs: fakeroot
	cd $(TOOLS_PATH) && $(TOOLS_PATH)/fakeroot/fakeroot \
		-i $(TOOLS_PATH)/fakeroot/.fake_env/$(MODEL).fake \
		-s $(TOOLS_PATH)/fakeroot/.fake_env/$(MODEL).fake \
		$(TOOLS_PATH)/mkfs.jffs2 \
		-r $(FS_TG_PATH) \
		-o $(IMG_TG_PATH)/rootfs.jffs2 \
		-p -n \
		$(INCLUDE_ENDIAN_FLAG_ROOTFS) \
		-e $(MTD_BLOCK_SIZE) \
		-x $(INCLUDE_COMPRESS_TYPE)

fs_rootfs_squash: fakeroot
	cd $(TOOLS_PATH) && $(TOOLS_PATH)/fakeroot/fakeroot \
		-i $(TOOLS_PATH)/fakeroot/.fake_env/$(MODEL).fake \
		-s $(TOOLS_PATH)/fakeroot/.fake_env/$(MODEL).fake \
		$(TOOLS_PATH)/mksquashfs4 \
		$(FS_TG_PATH) \
		$(IMG_TG_PATH)/rootfs \
		-nopad \
		-noappend \
		-all-root \
		-b $(shell printf "%d" $(SQUASH_BLOCK_SIZE)) \
		-comp $(INCLUDE_COMPRESS_TYPE)
ifeq ($(INCLUDE_TTNET), y)
	cp -pR $(DM_TG_PATH)/reduced_data_model_official.xml $(FS_TG_PATH)/etc/reduced_data_model.xml
	$(TOOLS_PATH)/enc -e -i $(FS_TG_PATH)/etc/reduced_data_model.xml
	cp -pR $(DM_TG_PATH)/default_config_enc.xml $(FS_TG_PATH)/etc/default_config.xml
	cd $(TOOLS_PATH) && $(TOOLS_PATH)/fakeroot/fakeroot \
		-i $(TOOLS_PATH)/fakeroot/.fake_env/$(MODEL).fake \
		-s $(TOOLS_PATH)/fakeroot/.fake_env/$(MODEL).fake \
		$(TOOLS_PATH)/mksquashfs4 \
		$(FS_TG_PATH) \
		$(IMG_TG_PATH)/rootfs.official \
		-nopad \
		-noappend \
		-all-root \
		-b $(shell printf "%d" $(MTD_BLOCK_SIZE)) \
		-comp $(INCLUDE_COMPRESS_TYPE)

	cp -pR $(DM_TG_PATH)/reduced_data_model_official_uptest.xml $(FS_TG_PATH)/etc/reduced_data_model.xml
