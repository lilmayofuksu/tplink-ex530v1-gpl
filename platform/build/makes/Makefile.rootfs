####################################################
#
# Build filesystem, prepare basic fs first
#
####################################################
DM_VERSION = "$(shell cat $(DM_TG_PATH)/reduced_data_model.xml | grep -w X_TP_DMVersion | sed 's/.*d=\(0x[0-9a-fA-F]\{1,\}\).*/\1/')"
CONFIG_VERSION = "$(shell cat $(DM_TG_PATH)/default_config.xml | grep -w X_TP_ConfigVersion | sed 's/.*val=\(0x[0-9a-fA-F]\{1,\}\).*/\1/')"

ifeq ($(INCLUDE_IMDA), y)
default_config = default_config.xml
reduced_data_model = reduced_data_model.xml
else
default_config = default_config.xml
reduced_data_model = reduced_data_model.xml
endif

FS_BUILD =
FS_BUILD += fs_clean
FS_BUILD += fs_create
FS_BUILD += fs_lib
FS_BUILD += fs_bin
FS_BUILD += fs_modules
FS_BUILD += fs_sysfiles
FS_BUILD += fs_check
FS_BUILD += fs_dev
FS_BUILD += fs_strip
FS_BUILD += fs_strip_post
FS_BUILD += fs_rootfs
FS_BUILD += fs_ver

FS_CLEAN = fs_clean
ifeq ($(INCLUDE_ECONET), y)
ifeq ($(strip $(SDK_DIR)),en7516)
else
ifeq ($(strip $(SDK_CONFIG)), UNION_EN7523_GLIBC_7915D_MAP_demo)
EXLIB_PATH = $(TOOLROOTPATH)/arm-buildroot-linux-gnueabi/lib
else ifeq ($(strip $(SDK_CONFIG)), UNION_EN7523_GLIBC_7916D_7623_MAP_demo)
EXLIB_PATH = $(TOOLROOTPATH)/arm-buildroot-linux-gnueabi/lib
else ifeq ($(strip $(SDK_CONFIG)), UNION_EN7580_SFU_KERNEL_4_4_demo)
EXLIB_PATH = $(TOOLROOTPATH)/mips-buildroot-linux-uclibc/lib
else
ifeq ($(strip $(TOOLROOTPATH)),)
TOOLROOTPATH :=/opt/trendchip/mips-linux-uclibc-4.6.3-kernel3.18/usr/
endif
ifeq ($(strip $(EXLIB_PATH)),)
EXLIB_PATH = $(TOOLROOTPATH)/mips-buildroot-linux-uclibc/lib
endif
endif
endif
endif
.PHONY: $(FS_BUILD) $(FS_CLEAN) fake_env

fake_env:
	mkdir -p $(TOOLS_PATH)/fakeroot/.fake_env && cd $(TOOLS_PATH)/fakeroot/.fake_env && echo > $(MODEL).fake

####################################################
# FS build
####################################################

fs_build: fs_clean $(FS_BUILD)

fs_check:
	if [ ! $(DM_VERSION) = $(CONFIG_VERSION) ]; \
	then \
		echo "WARNING: X_TP_ConfigVersion in $(default_config) not the same with X_TP_DMVersion"; \
		exit 1; \
	fi

fs_clean:
	rm -rf $(FS_TG_PATH)

fs_create: fake_env
	cp -pRfT $(TARGETS_PATH)/fs.dir $(FS_TG_PATH)
	find  $(FS_TG_PATH) -name ".svn" | xargs rm -rf
	find  $(FS_TG_PATH) -name ".gitignore" | xargs rm -rf
	
	mkdir -p $(FS_TG_PATH)/lib/modules/kmdir/
	mkdir -p $(FS_TG_PATH)/bin/

	cp $(MODEL_PATH)/inittab $(FS_TG_PATH)/etc
	cp $(MODEL_PATH)/rcS $(FS_TG_PATH)/etc/init.d/
	cp $(MODEL_PATH)/rcS.model $(FS_TG_PATH)/etc/init.d/

	test -e $(MODEL_PATH)/banner && cp $(MODEL_PATH)/banner $(FS_TG_PATH)/etc/ || echo ""
	test -e $(MODEL_PATH)/profile && cp $(MODEL_PATH)/profile $(FS_TG_PATH)/etc/ || echo ""
	
	echo "dropbear:x:500:500:dropbear:/var/tmp/dropbear:/bin/sh" > $(FS_TG_PATH)/etc/passwd.bak
	echo "nobody:*:0:0:nobody:/:/bin/sh" >> $(FS_TG_PATH)/etc/passwd.bak
ifeq ($(INCLUDE_USB_SAMBA_SERVER), y)
	echo "guest:*:0:0:guest:/var/usbdisk/:/bin/sh" >> $(FS_TG_PATH)/etc/passwd.bak
endif
ifneq ($(INCLUDE_SERIAL_SYNC_CMM_ADMIN_ACCOUNT), y)
	echo "admin:I55OiXWnKr89Y:0:0:root:/:/bin/sh" >> $(FS_TG_PATH)/etc/passwd.bak
endif

ifeq ($(INCLUDE_MTK), y)
	cp $(MODEL_PATH)/smp.sh $(FS_TG_PATH)/etc/
	cp $(MODEL_PATH)/init_console.sh $(FS_TG_PATH)/etc/init.d/
endif
ifeq ($(INCLUDE_CORE_BINDING), y)
	cp $(MODEL_PATH)/coreBinding.sh $(FS_TG_PATH)/etc/init.d/
endif
	
	cp $(MODEL_PATH)/config.bba $(FS_TG_PATH)/etc/
	cp $(MODEL_PATH)/config.sdk $(FS_TG_PATH)/etc/
	cp $(MODEL_PATH)/rcS.$(SUPPLIER) $(FS_TG_PATH)/etc/init.d/
ifeq ($(INCLUDE_ECONET), y)
ifeq ($(strip $(SDK_CONFIG)), UNION_EN7561D_LE_7915D_demo)
	cp -rpf $(MODEL_PATH)/wlan_config/* $(FS_TG_PATH)/etc/
else ifeq ($(strip $(SDK_CONFIG)), UNION_EN7523_GLIBC_7916D_7623_MAP_demo)
	find $(MODEL_PATH)/wlan_config/ -maxdepth 1 -type f | xargs -i cp -p {} $(FS_TG_PATH)/etc/
	test -e $(MODEL_PATH)/wlan_config/firmware && cp -fr $(MODEL_PATH)/wlan_config/firmware $(FS_TG_PATH)/lib || echo ""
else
	cp -p $(MODEL_PATH)/wlan_config/* $(FS_TG_PATH)/etc/
endif
endif

ifeq ($(strip $(MODEL)), EX221-G5V1)
	cp $(MODEL_PATH)/wlan_config/MT7915_iPAiLNA_EEPROM.bin $(FS_TG_PATH)/etc/MT7915_iPAiLNA_EEPROM.bin
	cp $(MODEL_PATH)/wlan_config/l1profile_MT7915.dat $(FS_TG_PATH)/etc/l1profile.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-TARGET_2g.dat $(FS_TG_PATH)/etc/mt7915-sku-TARGET_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-bf-TARGET_2g.dat $(FS_TG_PATH)/etc/mt7915-sku-bf-TARGET_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-CE_2g.dat $(FS_TG_PATH)/etc/mt7915-sku-CE_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-bf-CE_2g.dat $(FS_TG_PATH)/etc/mt7915-sku-bf-CE_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-TARGET_5g.dat $(FS_TG_PATH)/etc/mt7915-sku-TARGET_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-bf-TARGET_5g.dat $(FS_TG_PATH)/etc/mt7915-sku-bf-TARGET_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-CE_5g.dat $(FS_TG_PATH)/etc/mt7915-sku-CE_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-bf-CE_5g.dat $(FS_TG_PATH)/etc/mt7915-sku-bf-CE_5g.dat
	cp -fr $(MODEL_PATH)/wlan_config/firmware $(FS_TG_PATH)/lib
endif

ifeq ($(strip $(MODEL)), HX220)
	cp $(MODEL_PATH)/wlan_config/MT7915_iPAiLNA_EEPROM.bin $(FS_TG_PATH)/etc/MT7915_iPAiLNA_EEPROM.bin
	cp $(MODEL_PATH)/wlan_config/l1profile_MT7915.dat $(FS_TG_PATH)/etc/l1profile.dat
