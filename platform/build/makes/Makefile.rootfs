	cp $(MODEL_PATH)/wlan_config/mt7915-sku-RCM_2g.dat $(FS_TG_PATH)/etc/mt7915-sku-RCM_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-bf-RCM_2g.dat $(FS_TG_PATH)/etc/mt7915-sku-bf-RCM_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-TARGET_5g.dat $(FS_TG_PATH)/etc/mt7915-sku-TARGET_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-bf-TARGET_5g.dat $(FS_TG_PATH)/etc/mt7915-sku-bf-TARGET_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-CE_5g.dat $(FS_TG_PATH)/etc/mt7915-sku-CE_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-bf-CE_5g.dat $(FS_TG_PATH)/etc/mt7915-sku-bf-CE_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-FCC_5g.dat $(FS_TG_PATH)/etc/mt7915-sku-FCC_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-bf-FCC_5g.dat $(FS_TG_PATH)/etc/mt7915-sku-bf-FCC_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-IC_5g.dat $(FS_TG_PATH)/etc/mt7915-sku-IC_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-bf-IC_5g.dat $(FS_TG_PATH)/etc/mt7915-sku-bf-IC_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-RCM_5g.dat $(FS_TG_PATH)/etc/mt7915-sku-RCM_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-bf-RCM_5g.dat $(FS_TG_PATH)/etc/mt7915-sku-bf-RCM_5g.dat
	cp -fr $(MODEL_PATH)/wlan_config/firmware $(FS_TG_PATH)/lib
endif
	
ifeq ($(strip $(MODEL)), EX230)
	cp $(MODEL_PATH)/wlan_config/MT7915_iPAiLNA_EEPROM.bin $(FS_TG_PATH)/etc/MT7915_iPAiLNA_EEPROM.bin
	cp $(MODEL_PATH)/wlan_config/l1profile_MT7915.dat $(FS_TG_PATH)/etc/l1profile.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-TARGET_2g.dat $(FS_TG_PATH)/etc/mt7915-sku-TARGET_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-bf-TARGET_2g.dat $(FS_TG_PATH)/etc/mt7915-sku-bf-TARGET_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-CE_2g.dat $(FS_TG_PATH)/etc/mt7915-sku-CE_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-bf-CE_2g.dat $(FS_TG_PATH)/etc/mt7915-sku-bf-CE_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-FCC_2g.dat $(FS_TG_PATH)/etc/mt7915-sku-FCC_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-bf-FCC_2g.dat $(FS_TG_PATH)/etc/mt7915-sku-bf-FCC_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-TARGET_5g.dat $(FS_TG_PATH)/etc/mt7915-sku-TARGET_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-bf-TARGET_5g.dat $(FS_TG_PATH)/etc/mt7915-sku-bf-TARGET_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-CE_5g.dat $(FS_TG_PATH)/etc/mt7915-sku-CE_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-bf-CE_5g.dat $(FS_TG_PATH)/etc/mt7915-sku-bf-CE_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-FCC_5g.dat $(FS_TG_PATH)/etc/mt7915-sku-FCC_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-bf-FCC_5g.dat $(FS_TG_PATH)/etc/mt7915-sku-bf-FCC_5g.dat
	cp -rf $(MODEL_PATH)/wlan_config/firmware $(FS_TG_PATH)/lib
endif
	
ifeq ($(strip $(MODEL)), HC220-G5V1)
	cp $(MODEL_PATH)/wlan_config/l1profile.dat $(FS_TG_PATH)/etc/l1profile.dat
	cp $(MODEL_PATH)/wlan_config/MT7613B_iPAiLNA.bin $(FS_TG_PATH)/etc/MT7613B_iPAiLNA.bin
	cp $(MODEL_PATH)/wlan_config/MT7603E_iPAiLNA.bin $(FS_TG_PATH)/etc/MT7603E_iPAiLNA.bin
	cp $(MODEL_PATH)/wlan_config/mt7603-sku.dat $(FS_TG_PATH)/etc/mt7603-sku-TARGET.dat
	cp $(MODEL_PATH)/wlan_config/mt7603-sku-CE.dat $(FS_TG_PATH)/etc/mt7603-sku-CE.dat
	cp $(MODEL_PATH)/wlan_config/mt7603-sku-FCC.dat $(FS_TG_PATH)/etc/mt7603-sku-FCC.dat
	cp $(MODEL_PATH)/wlan_config/mt7663-sku.dat $(FS_TG_PATH)/etc/mt7663-sku-TARGET.dat
	cp $(MODEL_PATH)/wlan_config/mt7663-sku-CE.dat $(FS_TG_PATH)/etc/mt7663-sku-CE.dat
	cp $(MODEL_PATH)/wlan_config/mt7663-sku-FCC.dat $(FS_TG_PATH)/etc/mt7663-sku-FCC.dat
endif

ifeq ($(strip $(MODEL)), EC223-G5V1)
	cp $(MODEL_PATH)/wlan_config/l1profile.dat $(FS_TG_PATH)/etc/l1profile.dat
	cp $(MODEL_PATH)/wlan_config/MT7613B_iPAiLNA.bin $(FS_TG_PATH)/etc/MT7613B_iPAiLNA.bin
	cp $(MODEL_PATH)/wlan_config/MT7603E_iPAiLNA.bin $(FS_TG_PATH)/etc/MT7603E_iPAiLNA.bin
	cp $(MODEL_PATH)/wlan_config/mt7603-sku.dat $(FS_TG_PATH)/etc/mt7603-sku-TARGET.dat
	cp $(MODEL_PATH)/wlan_config/mt7603-sku-CE.dat $(FS_TG_PATH)/etc/mt7603-sku-CE.dat
	cp $(MODEL_PATH)/wlan_config/mt7603-sku-FCC.dat $(FS_TG_PATH)/etc/mt7603-sku-FCC.dat
	cp $(MODEL_PATH)/wlan_config/mt7663-sku.dat $(FS_TG_PATH)/etc/mt7663-sku-TARGET.dat
	cp $(MODEL_PATH)/wlan_config/mt7663-sku-CE.dat $(FS_TG_PATH)/etc/mt7663-sku-CE.dat
	cp $(MODEL_PATH)/wlan_config/mt7663-sku-FCC.dat $(FS_TG_PATH)/etc/mt7663-sku-FCC.dat
endif

ifeq ($(strip $(MODEL)), NX440-G5vV1)
	cp $(MODEL_PATH)/smp.sh $(FS_TG_PATH)/etc/
	cp $(MODEL_PATH)/wlan_config/e2p* $(FS_TG_PATH)/etc/
	cp $(MODEL_PATH)/wlan_config/l1profile.dat $(FS_TG_PATH)/etc/l1profile.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku.dat $(FS_TG_PATH)/etc/mt7915-sku.dat
	cp $(MODEL_PATH)/wlan_config/mt7915-sku-bf.dat $(FS_TG_PATH)/etc/mt7915-sku-bf.dat
endif

ifeq ($(strip $(MODEL)), EX820V1)
	cp $(MODEL_PATH)/wlan_config/MT7986_iPAiLNA_EEPROM_AX6000.bin $(FS_TG_PATH)/etc/MT7986_iPAiLNA_EEPROM_AX6000.bin
	cp $(MODEL_PATH)/wlan_config/l1profile_MT7986.dat $(FS_TG_PATH)/etc/l1profile.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-TARGET_2g.dat $(FS_TG_PATH)/etc/mt7986-sku-TARGET_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-bf-TARGET_2g.dat $(FS_TG_PATH)/etc/mt7986-sku-bf-TARGET_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-CE_2g.dat $(FS_TG_PATH)/etc/mt7986-sku-CE_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-bf-CE_2g.dat $(FS_TG_PATH)/etc/mt7986-sku-bf-CE_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-TARGET_5g.dat $(FS_TG_PATH)/etc/mt7986-sku-TARGET_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-bf-TARGET_5g.dat $(FS_TG_PATH)/etc/mt7986-sku-bf-TARGET_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-CE_5g.dat $(FS_TG_PATH)/etc/mt7986-sku-CE_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-bf-CE_5g.dat $(FS_TG_PATH)/etc/mt7986-sku-bf-CE_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-FCC_5g.dat $(FS_TG_PATH)/etc/mt7986-sku-FCC_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-bf-FCC_5g.dat $(FS_TG_PATH)/etc/mt7986-sku-bf-FCC_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-FCC_2g.dat $(FS_TG_PATH)/etc/mt7986-sku-FCC_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-bf-FCC_2g.dat $(FS_TG_PATH)/etc/mt7986-sku-bf-FCC_2g.dat
endif

ifeq ($(strip $(MODEL)), HX820V1)
	cp $(MODEL_PATH)/wlan_config/MT7986_iPAiLNA_EEPROM_AX6000.bin $(FS_TG_PATH)/etc/MT7986_iPAiLNA_EEPROM_AX6000.bin
	cp $(MODEL_PATH)/wlan_config/l1profile_MT7986.dat $(FS_TG_PATH)/etc/l1profile.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-TARGET_2g.dat $(FS_TG_PATH)/etc/mt7986-sku-TARGET_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-bf-TARGET_2g.dat $(FS_TG_PATH)/etc/mt7986-sku-bf-TARGET_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-CE_2g.dat $(FS_TG_PATH)/etc/mt7986-sku-CE_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-bf-CE_2g.dat $(FS_TG_PATH)/etc/mt7986-sku-bf-CE_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-TARGET_5g.dat $(FS_TG_PATH)/etc/mt7986-sku-TARGET_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-bf-TARGET_5g.dat $(FS_TG_PATH)/etc/mt7986-sku-bf-TARGET_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-CE_5g.dat $(FS_TG_PATH)/etc/mt7986-sku-CE_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-bf-CE_5g.dat $(FS_TG_PATH)/etc/mt7986-sku-bf-CE_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-FCC_5g.dat $(FS_TG_PATH)/etc/mt7986-sku-FCC_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-bf-FCC_5g.dat $(FS_TG_PATH)/etc/mt7986-sku-bf-FCC_5g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-FCC_2g.dat $(FS_TG_PATH)/etc/mt7986-sku-FCC_2g.dat
	cp $(MODEL_PATH)/wlan_config/mt7986-sku-bf-FCC_2g.dat $(FS_TG_PATH)/etc/mt7986-sku-bf-FCC_2g.dat
endif

ifeq ($(strip $(MODEL)), EX920V1)
	cp $(MODEL_PATH)/wlan_config/* $(FS_TG_PATH)/etc/
endif

ifeq ($(strip $(MODEL)), EX820v)
	cp $(MODEL_PATH)/wlan_config/* $(FS_TG_PATH)/etc/
	cp $(MODEL_PATH)/voip_sdk/ve_vtsp_main $(FS_TG_PATH)/usr/sbin/
endif

ifeq ($(strip $(MODEL)), EX821v)
	cp $(MODEL_PATH)/wlan_config/* $(FS_TG_PATH)/etc/
	cp $(MODEL_PATH)/voip_sdk/ve_vtsp_main $(FS_TG_PATH)/usr/sbin/
endif

ifeq ($(INCLUDE_WIFI_RTL), y)
ifeq ($(INCLUDE_WIRELESS_UCI), y)
	cp -rf $(MODEL_PATH)/exfiles/etc/* $(FS_TG_PATH)/etc/
	ln -s /tmp/config_uci $(FS_TG_PATH)/etc/config
endif
endif

ifeq ($(INCLUDE_EASYMESH), y)
	cp -pR $(MODEL_PATH)/mapBhOpt.conf $(FS_TG_PATH)/etc/mapBhOpt.conf
endif

	rm -f $(FS_TG_PATH)/tmp
	cd $(FS_TG_PATH) && ln -sfn /var/tmp tmp

ifneq ($(INCLUDE_CWMP_SSL_VERIFY_PEER), y)
	@rm -fr $(FS_TG_PATH)/etc/cert
endif
ifneq ($(INCLUDE_VOIP), y)
	@rm -fr $(FS_TG_PATH)/etc/voiceNotify
endif	

	cp $(BUILD_PATH)/platform_ver $(FS_TG_PATH)/etc/	

fs_lib:
ifeq ($(INCLUDE_ECONET), y)
ifeq ($(findstring $(SDK_DIR), en7580 en7529),$(SDK_DIR))
	cp -P $(SLIB_PATH)/*.so* $(FS_TG_PATH)/lib/
else
	cp -P $(SLIB_PATH)/lib/*.so* $(FS_TG_PATH)/lib/
endif
endif

ifeq ($(INCLUDE_REALTEK), y)
	cp -P $(SLIB_PATH)/lib/*.so* $(FS_TG_PATH)/lib/
endif

ifeq ($(INCLUDE_BROADCOM), y)
	cp -L $(SLIB_PATH)/lib/ld-linux*.so* $(FS_TG_PATH)/lib/
	cp -P $(SLIB_PATH)/lib/lib*.so* $(FS_TG_PATH)/lib/
endif
ifeq ($(INCLUDE_QUALCOMM), y)
	cp -L $(SLIB_PATH)/ld-*.so* $(FS_TG_PATH)/lib/
	cp -P $(SLIB_PATH)/lib*.so* $(FS_TG_PATH)/lib/
endif
ifeq ($(INCLUDE_MTK), y)
	cp -L $(SLIB_PATH)/lib/ld-*.so* $(FS_TG_PATH)/lib/
	cp -P $(SLIB_PATH)/lib/lib*.so* $(FS_TG_PATH)/lib/
endif

ifeq ($(INCLUDE_QUECTEL), y)
	cp -L $(SLIB_PATH)/ld-*.so* $(FS_TG_PATH)/lib/
	cp -P $(SLIB_PATH)/lib*.so* $(FS_TG_PATH)/lib/
endif

ifneq ($(KSLIB_PATH),)
	mkdir -p $(FS_TG_PATH)/lib64
	cp -L $(KSLIB_PATH)/lib64/ld-linux*.so* $(FS_TG_PATH)/lib/
	cp -P $(KSLIB_PATH)/lib64/lib*.so* $(FS_TG_PATH)/lib64/
endif

ifeq ($(INCLUDE_SPEEDTEST),y)
ifeq ($(strip $(SDK_CONFIG)), UNION_EN7523_GLIBC_7915D_MAP_demo)
	test -e $(EXLIB_PATH) && cp -a $(EXLIB_PATH)/libstdc++.so.6.0.20 $(FS_TG_PATH)/lib/ && cp -a $(EXLIB_PATH)/libstdc++.so.6 $(FS_TG_PATH)/lib/
else ifeq ($(strip $(SDK_CONFIG)), UNION_EN7523_GLIBC_7916D_7623_MAP_demo)
	test -e $(EXLIB_PATH) && cp -a $(EXLIB_PATH)/libstdc++.so.6.0.20 $(FS_TG_PATH)/lib/ && cp -a $(EXLIB_PATH)/libstdc++.so.6 $(FS_TG_PATH)/lib/
else ifeq ($(INCLUDE_BROADCOM),y)
	test -e $(TOOLROOTPATH) && cp -a $(TOOLROOTPATH)/arm-buildroot-linux-gnueabi/lib/libstdc++.so.6.0.27 $(FS_TG_PATH)/lib/ && cp -a $(TOOLROOTPATH)/arm-buildroot-linux-gnueabi/lib/libstdc++.so.6 $(FS_TG_PATH)/lib/
else
	test -e $(EXLIB_PATH) && cp -a $(EXLIB_PATH)/libstdc++.so.6.0.16 $(FS_TG_PATH)/lib/ && cp -a $(EXLIB_PATH)/libstdc++.so.6 $(FS_TG_PATH)/lib/
endif
endif
ifeq ($(INCLUDE_QUALCOMM), y)
	cd $(FS_TG_PATH) && ln -sfn lib lib64
	mkdir -p $(FS_TG_PATH)/lib/modules/kmdir/kernel/net/ipv4
	cd $(FS_TG_PATH)/lib/modules/kmdir/kernel/net/ipv4 && ln -sfn ../../../../../modules netfilter
	cd $(FS_TG_PATH)/lib/modules/kmdir/kernel/net/ && ln -sfn ../../../../modules netfilter
	mkdir -p $(FS_TG_PATH)/lib/modules/kmdir/kernel/drivers/net
	cd $(FS_TG_PATH)/lib/modules/kmdir/kernel/drivers/net && ln -sfn ../../../../../modules usb
	mkdir -p $(FS_TG_PATH)/lib/modules/kmdir/kernel/drivers/usb
	cd $(FS_TG_PATH)/lib/modules/kmdir/kernel/drivers/usb && ln -sfn ../../../../../modules serial
	cd $(FS_TG_PATH)/lib/modules/kmdir/kernel/drivers/usb && ln -sfn ../../../../../modules class
endif

ifeq ($(INCLUDE_QUECTEL), y)
	cd $(FS_TG_PATH) && ln -sfn lib lib64
