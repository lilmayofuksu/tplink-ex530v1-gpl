	#sed -i '/<WANPacketsCapture/{n;n;n;s#<Lock t=b r=W d=1 />#<Lock t=b r=W d=0 />#;}' $(DM_TG_PATH)/default_config_dev.xml
	#sed -i '/<PortMirrorSettings/{n;n;n;s#<Lock t=b r=W d=1 />#<Lock t=b r=W d=0 />#;}' $(DM_TG_PATH)/default_config_dev.xml
