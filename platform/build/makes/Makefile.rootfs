		$(TOOLS_PATH)/mkcfg -m $(MODEL_PATH)/file/reduced_data_model.xml -s $(MODEL_PATH)/$(reduced_data_model) -o $(FS_TG_PATH)/etc/reduced_data_model.xml; \
	else \
