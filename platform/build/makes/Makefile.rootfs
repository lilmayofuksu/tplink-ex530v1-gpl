		-b $(shell printf "%d" $(MTD_BLOCK_SIZE)) \
		-comp $(INCLUDE_COMPRESS_TYPE)

	cp -pR $(DM_TG_PATH)/reduced_data_model_dev.xml $(FS_TG_PATH)/etc/reduced_data_model.xml
	$(TOOLS_PATH)/enc -e -i $(FS_TG_PATH)/etc/reduced_data_model.xml
	cp -pR $(DM_TG_PATH)/default_config_dev_enc.xml $(FS_TG_PATH)/etc/default_config.xml
	cd $(TOOLS_PATH) && $(TOOLS_PATH)/fakeroot/fakeroot \
