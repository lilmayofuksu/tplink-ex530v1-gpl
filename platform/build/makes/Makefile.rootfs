	cp -pR $(FS_TG_PATH)/etc/default_config.xml $(DM_TG_PATH)
	$(TOOLS_PATH)/enc -e -i $(FS_TG_PATH)/etc/default_config.xml

ifeq ($(INCLUDE_TTNET), y)
	$(TOOLS_PATH)/enc -e -i $(DM_TG_PATH)/default_config.xml -o $(DM_TG_PATH)/default_config_enc.xml
