	mkdir -p $(FS_TG_PATH)/usr/lib
ifeq ($(INCLUDE_ECONET), y)
ifeq ($(strip $(SDK_CONFIG)), UNION_EN7523_GLIBC_7915D_MAP_demo)
	cp -a $(EXLIB_PATH)/libstdc++.so.6.0.20 $(FS_TG_PATH)/lib/ && cp -a $(EXLIB_PATH)/libstdc++.so.6 $(FS_TG_PATH)/lib/
else ifeq ($(strip $(SDK_CONFIG)), UNION_EN7523_GLIBC_7916D_7623_MAP_demo)
	cp -a $(EXLIB_PATH)/libstdc++.so.6.0.20 $(FS_TG_PATH)/lib/ && cp -a $(EXLIB_PATH)/libstdc++.so.6 $(FS_TG_PATH)/lib/
else
ifneq ($(strip $(SDK_CONFIG)), UNION_EN7580_SFU_KERNEL_4_4_demo)
	cp -P $(SLIB_PATH)/usr/lib/libstdc++.so* $(FS_TG_PATH)/usr/lib/
endif
endif
else ifeq ($(INCLUDE_MTK), y)
	cp -P $(SLIB_PATH)/lib/libstdc++.so* $(FS_TG_PATH)/usr/lib/
else ifeq ($(INCLUDE_BROADCOM), y)
	cp -P $(SLIB_PATH)/usr/lib/libstdc++.so* $(FS_TG_PATH)/usr/lib/
else ifeq ($(INCLUDE_REALTEK), y)
	cp -P $(SLIB_PATH)/lib/libstdc++.so* $(FS_TG_PATH)/usr/lib/
else
	cp -P $(SLIB_PATH)/libstdc++.so* $(FS_TG_PATH)/usr/lib/
endif
ifneq ($(KSLIB_PATH),)
	mkdir -p $(FS_TG_PATH)/usr/lib64
	cp -P $(KSLIB_PATH)/usr/lib64/libstdc++.so* $(FS_TG_PATH)/usr/lib64/
endif
endif

ifeq ($(INCLUDE_LTE_WIFI_COEX), y)
	cp $(MODEL_PATH)/LteCoexTx.conf $(FS_TG_PATH)/lib/
	cp $(MODEL_PATH)/LteCoexRx.conf $(FS_TG_PATH)/lib/
