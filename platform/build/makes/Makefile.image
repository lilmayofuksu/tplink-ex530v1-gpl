endif
endif

ifeq ($(INCLUDE_ECONET), y)
	$(TOOLS_PATH)/mkimage4_econet \
		-t $(MKIMAGE_TYPE) \
		-s $(INCLUDE_FLASH_BIN_SIZE) \
		-l $(MTD_IMAGE_SIZE) \
		-m 0 \
		-e $(INCLUDE_ENDIAN_FLAG_IMAGE) \
		-p $(DM_TG_PATH)/reduced_data_model.xml \
		-b $(IMG_TG_PATH)/$(MODEL)_UP_BOOT.w \
		-k $(IMG_TG_PATH)/empty_kernel \
		-f $(IMG_TG_PATH)/empty_rootfs \
		-v $(KERNEL_TG_PATH)/vmlinux \
		-i $(IMG_TG_PATH) \
		-o $(MODEL);
else ifeq ($(INCLUDE_MTK), y)
	$(TOOLS_PATH)/mkimage4 \
		-t $(MKIMAGE_TYPE) \
		-s $(INCLUDE_FLASH_BIN_SIZE) \
		-l $(MTD_BOOT_SIZE) \
		-m $(MTD_KERNEL_SIZE) \
		-n $(MTD_MISC_SIZE) \
		-e $(INCLUDE_ENDIAN_FLAG_IMAGE) \
		-p $(DM_TG_PATH)/reduced_data_model.xml \
		-k $(IMG_TG_PATH)/$(MODEL)_UP.w \
		-f $(IMG_TG_PATH)/empty_rootfs \
		-c $(MFGFILE) \
		-a $(IMG_TG_PATH)/empty_rootfs \
		-v $(KERNEL_TG_PATH)/vmlinux \
		$(MKIMAGE_PREHOOK_ARG) \
		-i $(IMG_TG_PATH) \
		-o $(MODEL);
else
	$(TOOLS_PATH)/mkimage4 \
		-t $(MKIMAGE_TYPE) \
		-s $(INCLUDE_FLASH_BIN_SIZE) \
		-l $(MTD_IMAGE_SIZE) \
		-m 0 \
		-e $(INCLUDE_ENDIAN_FLAG_IMAGE) \
		-p $(DM_TG_PATH)/reduced_data_model.xml \
		-b $(IMG_TG_PATH)/$(MODEL)_UP_BOOT.w \
        -k $(IMG_TG_PATH)/empty_kernel \
        -f $(IMG_TG_PATH)/empty_rootfs \
		-v $(KERNEL_TG_PATH)/vmlinux \
		$(MKIMAGE_PREHOOK_ARG) \
		-i $(IMG_TG_PATH) \
		-o $(MODEL);
endif

	rm -f $(IMG_TG_PATH)/empty_kernel;
	rm -f $(IMG_TG_PATH)/empty_rootfs;
	
release_build:
	mkdir -p $(RELEASE_IMG_PATH)
	# why supplier_xxx?
	make supplier_release_build

