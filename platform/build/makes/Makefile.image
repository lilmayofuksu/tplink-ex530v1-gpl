endif #INCLUDE_BOOT_AGINETCONFIG
	
# ubinize
#	-p(byte): PEB Size
#	-m(byte): Min-I/O Size of flash
#	-s(byte): Page Size
#	-o: ouput file
#	ubinize.cfg: UBI partition layout
bba_image_type_ubi:
	@echo "#####################################"
	@echo "Generate UBI image"
	@echo "#####################################"
	rm -rf $(IMG_TG_PATH)/FLASH.bin && \
	cp $(IMG_TG_PATH)/$(MODEL_NAME)_tag_kernel.bin $(IMG_TG_PATH)/kernel.img && \
	mkdir -p $(IMG_TG_PATH)/blankdir && \
	echo 1 > $(IMG_TG_PATH)/blankdir/blankfile && \
	$(TOOLS_PATH)/mkfs.jffs2 \
		-r $(IMG_TG_PATH)/blankdir \
		-o $(IMG_TG_PATH)/blankfile.img \
		-p -n \
		-m none \
		$(INCLUDE_ENDIAN_FLAG_ROOTFS) \
		-e $(MTD_BLOCK_SIZE)
	cd $(IMG_TG_PATH) && \
	$(TOOLS_PATH)/ubinize \
		-p 128KiB \
		-m 2048 \
		-s 2048 \
		-o $(IMG_TG_PATH)/ubi_system.img \
		$(MODEL_PATH)/ubinize.cfg
	@echo "#####################################"
	@echo "Generate FLASH image"
	@echo "#####################################"
	@echo "BOOT part:"
	@echo "#####################################"
	len=`wc -c $(BOOT_TG_PATH)/boot.bin | awk '{ printf $$1 }'` && \
	countt=`expr $$(($(MTD_BOOT_SIZE))) - $$len` && \
	cat $(BOOT_TG_PATH)/boot.bin > $(IMG_TG_PATH)/boot.padded && \
	dd if=/dev/zero of=$(IMG_TG_PATH)/boot.padded bs=1 count=$$countt seek=$$len;
	cat $(IMG_TG_PATH)/boot.padded >> $(IMG_TG_PATH)/FLASH.bin
	@echo "#####################################"
	@echo "MISC part:"
	@echo "#####################################"
	len=`wc -c $(IMG_TG_PATH)/blankfile.img | awk '{ printf $$1 }'` && \
	countt=`expr $$(($(MTD_MISC_SIZE))) - $$len` && \
	cat $(IMG_TG_PATH)/blankfile.img > $(IMG_TG_PATH)/misc.padded && \
	dd if=/dev/zero of=$(IMG_TG_PATH)/misc.padded bs=1 count=$$countt seek=$$len;
	cat $(IMG_TG_PATH)/misc.padded >> $(IMG_TG_PATH)/FLASH.bin
	@echo "#####################################"
	@echo "UBI part:"
	@echo "#####################################"
	cat $(IMG_TG_PATH)/ubi_system.img  >> $(IMG_TG_PATH)/FLASH.bin
	mv $(IMG_TG_PATH)/rootfs $(IMG_TG_PATH)/rootfs.img
	rm -rf $(IMG_TG_PATH)/*.padded $(IMG_TG_PATH)/blankdir
	@echo "#####################################"
	@echo "Convert Flash.bin with ECC"
	@echo "#####################################"
	$(TOOLS_PATH)/nand_ecc -i $(IMG_TG_PATH)/FLASH.bin -o $(IMG_TG_PATH)/FLASH_ECC.bin -p 2048 -s 4 -b 64


