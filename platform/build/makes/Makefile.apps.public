libssh: 
	@echo "build libssh"
	cd $(PUBLIC_APPS_PATH)/libssh-0.9.4 && rm -rf build
	cd $(PUBLIC_APPS_PATH)/libssh-0.9.4 && mkdir build
	cd $(PUBLIC_APPS_PATH)/libssh-0.9.4/build && cmake -DCMAKE_INSTALL_PREFIX=$(PUBLIC_APPS_PATH)/libssh-0.9.4/install -DCMAKE_BUILD_TYPE:STRING=Release \
		-DWITH_EXAMPLES=OFF -DWITH_GCRYPT=OFF -DCMAKE_C_FLAGS="-D_GNU_SOURCE" -DTHREADS_PTHREAD_ARG=OFF \
		-DWITH_GSSAPI=OFF -DWITH_ZLIB=OFF -DWITH_NACL=OFF -DWITH_PCAP=OFF -DWITH_SERVER=OFF -DWITH_SFTP=OFF \
		-DCMAKE_SYSTEM_NAME=Linux -DCMAKE_FIND_ROOT_PATH=$(TOOLCHAIN_PATH) -DCMAKE_C_COMPILER=$(HOST)-gcc \
		-DOPENSSL_ROOT_DIR=$(PUBLIC_APPS_PATH)/$(INCLUDE_SSL_LIB_NAME)/install ../
	cd $(PUBLIC_APPS_PATH)/libssh-0.9.4/build && $(MAKE) install

libssh_install:
	@echo "install libssh"
	cp -p $(PUBLIC_APPS_PATH)/libssh-0.9.4/install/lib/libssh.so.4.8.5 $(FS_TG_PATH)/lib/
	cd $(FS_TG_PATH)/lib/ && ln -sf libssh.so.4.8.5 libssh.so.4
	cd $(FS_TG_PATH)/lib/ && ln -sf libssh.so.4.8.5 libssh.so
libssh_clean:
	@echo "clean libssh"
	-cd $(PUBLIC_APPS_PATH)/libssh-0.9.4 && rm -fr build install
libssh_ver:
	echo "libssh version : 0.9.4" >> $(BBA_PRODUCT_VER_FILE)

ifneq ($(strip $(INCLUDE_MTK)),)
CURL_EXTRA_CONFIG= -lpthread -ldl
endif

ifeq ($(INCLUDE_ECONET_TR143_SPEEDUP),y)
	CURL_FTP_SUPPORT=--enable-ftp
else
	CURL_FTP_SUPPORT=--disable-ftp
endif
	
curl:
	@echo "build curl"
	cd $(CURL_DIR) && test ! -e Makefile || if ! egrep "$(TOOLPREFIX)" Makefile > /dev/null; then \
		rm Makefile; \
	fi

ifeq ($(INCLUDE_CLOUD_HTTPS), y)
	-cd $(CURL_DIR) && test ! -e Makefile || if egrep "without-ssl" Makefile > /dev/null; then \
		$(MAKE) clean && rm Makefile; \
	fi
	-cd $(CURL_DIR) && test -e Makefile || (export LDFLAGS="-Wl,-rpath=$(PUBLIC_APPS_PATH)/$(INCLUDE_SSL_LIB_NAME)/install/lib $(CURL_EXTRA_CONFIG)" &&\
	./configure --prefix=$(CURL_DIR)/install \
				--build=i686-linux --host=$(HOST) \
				--enable-static ${CURL_FTP_SUPPORT} --disable-ldap --disable-ldaps --disable-rtsp --disable-proxy --disable-dict \
				--disable-telnet --disable-tftp --disable-pop3 --disable-imap --disable-smtp --disable-gopher \
				--disable-ipv6 --disable-sspi --disable-ntlm-wb --disable-tls-srp \
				--disable-cookies --disable-soname-bump --disable-threaded-resolver --disable-pthreads \
				--with-ssl=$(PUBLIC_APPS_PATH)/$(INCLUDE_SSL_LIB_NAME)/install --without-zlib )
else
	-cd $(CURL_DIR) && test ! -e Makefile || if egrep "with-ssl" Makefile > /dev/null; then \
		$(MAKE) clean && rm Makefile; \
	fi
	-cd $(CURL_DIR) && test -e Makefile ||\
	./configure --prefix=$(CURL_DIR)/install \
				--build=i686-linux --host=$(HOST) \
				${CURL_FTP_SUPPORT} --disable-ldap --disable-ldaps --disable-rtsp --disable-proxy --disable-dict \
				--disable-telnet --disable-tftp --disable-pop3 --disable-imap --disable-smtp --disable-gopher \
				--disable-ipv6 --disable-sspi --disable-ntlm-wb --disable-tls-srp \
				--disable-cookies --disable-soname-bump --without-zlib --disable-threaded-resolver --disable-pthreads \
				--without-ssl
endif
	-cd $(CURL_DIR) && $(MAKE) install-strip

curl_install:
	@echo "install curl"
	cp -P $(CURL_DIR)/install/lib/*.so* $(FS_TG_PATH)/lib/
	cp -P $(CURL_DIR)/install/bin/curl $(FS_TG_PATH)/usr/sbin

curl_clean:
	cd $(CURL_DIR) && test ! -f Makefile || $(MAKE) clean && rm -rf ./install
curl_ver:
	echo "curl version : 7.62.0" >> $(BBA_PRODUCT_VER_FILE)

udpxy:
	cd $(PUBLIC_APPS_PATH)/udpxy-1.0 && $(MAKE)
udpxy_install:
	cp -P $(PUBLIC_APPS_PATH)/udpxy-1.0/udpxy $(FS_TG_PATH)/usr/bin
udpxy_clean:
	cd $(PUBLIC_APPS_PATH)/udpxy-1.0 && $(MAKE) clean
udpxy_ver:
	echo "udpxy version : 1.0" >> $(BBA_PRODUCT_VER_FILE)

cJSON:
	@echo "build cJSON"
	cd $(PUBLIC_APPS_PATH)/cJSON/ && rm -rf build
	cd $(PUBLIC_APPS_PATH)/cJSON/ && rm -rf install
	cd $(PUBLIC_APPS_PATH)/cJSON/ && mkdir build
	cd $(PUBLIC_APPS_PATH)/cJSON/ && mkdir install
	cd $(PUBLIC_APPS_PATH)/cJSON/install && mkdir cjson
	cd $(PUBLIC_APPS_PATH)/cJSON/build/ && cmake ..
	cd $(PUBLIC_APPS_PATH)/cJSON/build/ && $(MAKE)
	cp -p $(PUBLIC_APPS_PATH)/cJSON/build/libcjson.so.1.7.14 $(PUBLIC_APPS_PATH)/cJSON/install/cjson
	cd $(PUBLIC_APPS_PATH)/cJSON/install/cjson && ln -sf libcjson.so.1.7.14 libcjson.so
	cp -p $(PUBLIC_APPS_PATH)/cJSON/cJSON.h $(PUBLIC_APPS_PATH)/cJSON/install/cjson/
cJSON_install:
	@echo "install cJSON"	
	cp -p $(PUBLIC_APPS_PATH)/cJSON/build/libcjson.so.1.7.14  $(FS_TG_PATH)/lib/
	cd $(FS_TG_PATH)/lib/ && ln -sf libcjson.so.1.7.14 libcjson.so
cJSON_clean:
	@echo "clean cJSON"
	cd $(PUBLIC_APPS_PATH)/cJSON/build && make clean
	cd $(PUBLIC_APPS_PATH)/cJSON/ && rm -rf build
	cd $(PUBLIC_APPS_PATH)/cJSON/ && rm -rf install
