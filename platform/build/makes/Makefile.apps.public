	cp $(MEDIA_SERVER_INSTALL)/lib/libavdevice.so.56.3.100 $(FS_TG_PATH)/lib
	cp $(MEDIA_SERVER_INSTALL)/lib/libexif.so.12.3.3 $(FS_TG_PATH)/lib
