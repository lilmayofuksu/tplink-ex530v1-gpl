DROPBEAR_CONFIG =	-disable-harden
ifneq ($(strip $(INCLUDE_AGINET_APP_V2)),)
DROPBEAR_CFLAGS += -D__LINUX_OS_FC__ -DINCLUDE_AGINET_APP_V2
DROPBEAR_CFLAGS += -I$(OS_LIB_PATH)/include
DROPBEAR_LIB += -L$(OS_LIB_PATH)/ -los
DROPBEAR_LIB += -lpthread -lrt -ldl
ifneq ($(strip $(INCLUDE_USER_RESTRICTION)),)
DROPBEAR_CFLAGS += -DINCLUDE_USER_RESTRICTION
endif
ifneq ($(strip $(INCLUDE_CLOUD_V2)),)
DROPBEAR_CFLAGS += -DINCLUDE_CLOUD -DINCLUDE_CLOUD_V2 
endif
endif
ifneq ($(strip $(INCLUDE_SSH_ACCESS)),)
DROPBEAR_CFLAGS += -DINCLUDE_SSH_ACCESS
endif
ifneq ($(strip $(INCLUDE_SAVE_KEY_AS_HASH)),)
DROPBEAR_CFLAGS += -DINCLUDE_SAVE_KEY_AS_HASH
endif
ifneq ($(strip $(INCLUDE_CLS_L1_IMDA_TPAPP)),)
DROPBEAR_CFLAGS += -DINCLUDE_CLS_L1_IMDA_TPAPP
endif
ifneq ($(strip $(INCLUDE_CHGINIT_PWD)),)
DROPBEAR_CFLAGS += -DINCLUDE_CHGINIT_PWD
endif
ifneq ($(strip $(INCLUDE_USER_RESTRICTION)),)
DROPBEAR_CFLAGS += -DINCLUDE_USER_RESTRICTION
endif
dropbear:
	cd $(PUBLIC_APPS_PATH)/dropbear-2020.80 && test -e Makefile || \
	(export CFLAGS+="-Wall -Werror=implicit-function-declaration"; \
		export CFLAGS+=" $(DROPBEAR_CFLAGS)"; \
		export LDFLAGS+="$(DROPBEAR_LIB)"; \
		./configure --host=$(HOST) --prefix=$(PUBLIC_APPS_PATH)/dropbear-2020.80/install \
		--disable-zlib --disable-syslog $(DROPBEAR_CONFIG)\
	)
	cd $(PUBLIC_APPS_PATH)/dropbear-2020.80 && $(MAKE) MULTI=1 SCPPROGRESS=1 install
dropbear_install:
	cp -p $(PUBLIC_APPS_PATH)/dropbear-2020.80/install/bin/dropbearmulti $(FS_TG_PATH)/usr/bin
	cd $(FS_TG_PATH)/usr/bin && ln -s dropbearmulti dropbear
	cd $(FS_TG_PATH)/usr/bin && ln -s dropbearmulti dropbearkey
	cd $(FS_TG_PATH)/usr/bin && ln -s dropbearmulti scp

dropbear_clean:
	cd $(PUBLIC_APPS_PATH)/dropbear-2020.80 && $(MAKE) clean
dropbear_ver:
	echo "dropbear version : 2020.80" >> $(BBA_PRODUCT_VER_FILE)

libsqlite:
	cd $(PUBLIC_APPS_PATH)/sqlite-autoconf-3160200 && touch * && ./configure --host=$(HOST) CFLAGS="-Os" \
	--enable-dynamic-extensions=no --enable-readline=no
