	cp $(MEDIA_SERVER_INSTALL)/lib/libtiffxx.so.5.2.0 $(FS_TG_PATH)/lib
	cp $(MEDIA_SERVER_INSTALL)/lib/libz.so.1.2.6 $(FS_TG_PATH)/lib
###link media_server related libs
	cd $(FS_TG_PATH)/lib/ && ln -sf libjpeg.so.9.0.0 libjpeg.so
	cd $(FS_TG_PATH)/lib/ && ln -sf libjpeg.so.9.0.0 libjpeg.so.9
	cd $(FS_TG_PATH)/lib/ && ln -sf libid3tag.so.0.3.0 libid3tag.so
	cd $(FS_TG_PATH)/lib/ && ln -sf libid3tag.so.0.3.0 libid3tag.so.0
#	cd $(FS_TG_PATH)/lib/ && ln -sf libsqlite3.so.0.8.6 libsqlite3.so
#	cd $(FS_TG_PATH)/lib/ && ln -sf libsqlite3.so.0.8.6 libsqlite3.so.0
	cd $(FS_TG_PATH)/lib/ && ln -sf libavformat.so.56.15.102 libavformat.so
	cd $(FS_TG_PATH)/lib/ && ln -sf libavformat.so.56.15.102 libavformat.so.56
	cd $(FS_TG_PATH)/lib/ && ln -sf libavutil.so.54.15.100 libavutil.so
	cd $(FS_TG_PATH)/lib/ && ln -sf libavutil.so.54.15.100 libavutil.so.54
	cd $(FS_TG_PATH)/lib/ && ln -sf libavcodec.so.56.13.100 libavcodec.so
	cd $(FS_TG_PATH)/lib/ && ln -sf libavcodec.so.56.13.100 libavcodec.so.56
	cd $(FS_TG_PATH)/lib/ && ln -sf libavdevice.so.56.3.100 libavdevice.so
	cd $(FS_TG_PATH)/lib/ && ln -sf libavdevice.so.56.3.100 libavdevice.so.56
	cd $(FS_TG_PATH)/lib/ && ln -sf libexif.so.12.3.3 libexif.so
	cd $(FS_TG_PATH)/lib/ && ln -sf libexif.so.12.3.3 libexif.so.12
	cd $(FS_TG_PATH)/lib/ && ln -sf libFLAC.so.8.2.0 libFLAC.so
	cd $(FS_TG_PATH)/lib/ && ln -sf libFLAC.so.8.2.0 libFLAC.so.8
	cd $(FS_TG_PATH)/lib/ && ln -sf libogg.so.0.6.0 libogg.so
	cd $(FS_TG_PATH)/lib/ && ln -sf libogg.so.0.6.0 libogg.so.0
	cd $(FS_TG_PATH)/lib/ && ln -sf libvorbis.so.0.4.3 libvorbis.so
	cd $(FS_TG_PATH)/lib/ && ln -sf libvorbis.so.0.4.3 libvorbis.so.0
#	cd $(FS_TG_PATH)/lib/ && ln -sf libiconv.so.2.5.1 libiconv.so
#	cd $(FS_TG_PATH)/lib/ && ln -sf libiconv.so.2.5.1 libiconv.so.2
	cd $(FS_TG_PATH)/lib/ && ln -sf libswscale.so.3.1.101 libswscale.so
	cd $(FS_TG_PATH)/lib/ && ln -sf libswscale.so.3.1.101 libswscale.so.3
	cd $(FS_TG_PATH)/lib/ && ln -sf libz.so.1.2.6 libz.so
	cd $(FS_TG_PATH)/lib/ && ln -sf libz.so.1.2.6 libz.so.1
	cd $(FS_TG_PATH)/lib/ && ln -sf libtiff.so.5.2.0 libtiff.so
	cd $(FS_TG_PATH)/lib/ && ln -sf libtiff.so.5.2.0 libtiff.so.5
	cd $(FS_TG_PATH)/lib/ && ln -sf libtiffxx.so.5.2.0 libtiffxx.so
	cd $(FS_TG_PATH)/lib/ && ln -sf libtiffxx.so.5.2.0 libtiffxx.so.5
ifeq ($(INCLUDE_USB_MEDIA_SERVER), y)
ifeq ($(INCLUDE_USHARE), y)
	cp -p $(PUBLIC_APPS_PATH)/ushare-1.1a/src/ushare $(FS_TG_PATH)/usr/bin
	cp -p $(PUBLIC_APPS_PATH)/ushare-1.1a/scripts/ushare.conf $(FS_TG_PATH)/etc/ushare.conf
else
	cp -p $(MEDIA_SERVER_INSTALL)/sbin/minidlnad $(FS_TG_PATH)/usr/sbin
	cp -p $(MEDIA_SERVER_PATH)/minidlna-1.1.4/minidlna.conf $(FS_TG_PATH)/etc
endif #INCLUDE_USHARE
endif #INCLUDE_USB_MEDIA_SERVER
dlna_clean:
ifeq ($(INCLUDE_USHARE), y)
	$(MAKE) -C $(PUBLIC_APPS_PATH)/ffmpeg-0.6 clean
	$(MAKE) -C $(PUBLIC_APPS_PATH)/libdlna-0.2.3 clean
	$(MAKE) -C $(PUBLIC_APPS_PATH)/ushare-1.1a clean
endif
ifeq ($(INCLUDE_MINIDLNA), y)
	cd $(PUBLIC_APPS_PATH)/media_server && $(MAKE) clean
endif
ifeq ($(INCLUDE_LITE_MINIDLNA), y)
	cd $(PUBLIC_APPS_PATH)/media_server && $(MAKE) lite_clean
endif
dlna_ver:
ifeq ($(INCLUDE_USHARE), y)
	echo "ffmpeg version : 0.6" >> $(BBA_PRODUCT_VER_FILE)
	echo "libdlna version : 0.2.3" >> $(BBA_PRODUCT_VER_FILE)
	echo "ushare version : 1.1a" >> $(BBA_PRODUCT_VER_FILE)
endif
ifeq ($(INCLUDE_MINIDLNA), y)
	echo "ffmpeg version : 2.5.2" >> $(BBA_PRODUCT_VER_FILE)
	echo "minidlna version : 1.1.4" >> $(BBA_PRODUCT_VER_FILE)
endif
	

openssl:
	cd $(PUBLIC_APPS_PATH)/$(INCLUDE_SSL_LIB_NAME) && test -e Makefile || ./Configure shared \
		no-afalgeng no-aria no-asan no-asm no-async enable-bf no-blake2 no-camellia \
		no-capieng enable-cast no-chacha no-cmac no-cms no-comp no-crypto-mdebug no-ct \
		enable-des no-devcryptoeng enable-dsa no-dso enable-ec \
		no-ec2m no-ecdh no-ecdsa no-egd enable-engine no-err no-external-tests no-gost \
		no-hw no-idea no-md2 no-mdc2 no-msan no-multiblock no-nextprotoneg \
		no-pinshared no-ocb no-poly1305 no-posix-io no-psk \
		enable-rc4 no-rc5 no-rdrand no-rfc3779 no-rmd160 no-scrypt no-sctp \
		no-seed no-siphash no-sm2 no-sm3 no-sm4 no-srp no-srtp no-sse2 \
		no-tests no-ts no-ubsan no-unit-test no-whirlpool no-zlib \
		enable-ssl3 enable-ssl3-method enable-ssl-trace enable-weak-ssl-ciphers \
		linux-generic32 --prefix=$(PUBLIC_APPS_PATH)/$(INCLUDE_SSL_LIB_NAME)/install

	cd $(PUBLIC_APPS_PATH)/$(INCLUDE_SSL_LIB_NAME) \
		&& $(MAKE) CROSS_COMPILE= CC=$(CC) LD=$(LD) SHARED_LDFLAGS="-s" depend install_sw

openssl_install:
	cp -pd $(PUBLIC_APPS_PATH)/$(INCLUDE_SSL_LIB_NAME)/install/bin/openssl $(FS_TG_PATH)/usr/sbin
	cp -pd $(PUBLIC_APPS_PATH)/$(INCLUDE_SSL_LIB_NAME)/apps/openssl.cnf $(FS_TG_PATH)/etc/
	cp -pd $(PUBLIC_APPS_PATH)/$(INCLUDE_SSL_LIB_NAME)/install/lib/libcrypto.so* $(FS_TG_PATH)/lib/
	cp -pd $(PUBLIC_APPS_PATH)/$(INCLUDE_SSL_LIB_NAME)/install/lib/libssl.so* $(FS_TG_PATH)/lib/


openssl_clean:
	-cd $(PUBLIC_APPS_PATH)/$(INCLUDE_SSL_LIB_NAME) && test -e Makefile && $(MAKE) clean  && rm -f Makefile
	-cd $(PUBLIC_APPS_PATH)/$(INCLUDE_SSL_LIB_NAME) && rm -rf ./install
openssl_ver:
	echo "openssl version : 1.1.1f" >> $(BBA_PRODUCT_VER_FILE)

mbedtls:
	cd $(PUBLIC_APPS_PATH)/mbedtls && CFLAGS="-I$(PUBLIC_APPS_PATH)/mbedtls/configs -DMBEDTLS_CONFIG_FILE='<config-mini-crypto.h>'" && \
	$(MAKE) CC=$(CC) LD=$(LD) SHARED=1 install


mbedtls_install:
	cp --no-dereference $(PUBLIC_APPS_PATH)/mbedtls/install/lib/libmbedcrypto.so* $(FS_TG_PATH)/lib/
	cp --no-dereference $(PUBLIC_APPS_PATH)/mbedtls/install/lib/libmbedtls.so* $(FS_TG_PATH)/lib/
	cp --no-dereference $(PUBLIC_APPS_PATH)/mbedtls/install/lib/libmbedx509.so* $(FS_TG_PATH)/lib/
	cp --no-dereference $(PUBLIC_APPS_PATH)/mbedtls/install/bin/mbedtls_aes-128-ecb $(FS_TG_PATH)/usr/sbin

mbedtls_clean:
	cd $(PUBLIC_APPS_PATH)/mbedtls && $(MAKE) clean
	cd $(PUBLIC_APPS_PATH)/mbedtls && rm -rf ./install

ifneq ($(strip $(INCLUDE_MTK)),)
IPSECTOOLS_EXTRA_CONFIG= LDFLAGS="-lpthread -ldl"
endif
ifeq ($(strip $(BCM_SDK_VERSION_ALL)), 5.04L.02P1)
IPSECTOOLS_EXTRA_CFLAGS= -Wno-error=format-truncation -Wno-error=stringop-truncation 
endif
ipsectools:
	cd $(PUBLIC_APPS_PATH)/ipsec-tools-0.8.2 && test -e Makefile || ( chmod 755 bootstrap && ./bootstrap && \
		./configure --host=$(HOST) --with-kernel-headers=$(KERNELHEADER) \
		--with-openssl=$(PUBLIC_APPS_PATH)/$(INCLUDE_SSL_LIB_NAME)/install --enable-security-context=no \
		--enable-shared=yes --enable-adminport=yes --enable-dpd=yes \
		--sharedstatedir=/var/ipsec --localstatedir=/var/ipsec \
		CFLAGS="-Os -D_DEFAULT_SOURCE -Wall -Werror=implicit-function-declaration $(IPSECTOOLS_EXTRA_CFLAGS)" \
		$(IPSECTOOLS_EXTRA_CONFIG))
	cd $(PUBLIC_APPS_PATH)/ipsec-tools-0.8.2 && $(MAKE)

ipsectools_install:
	cp -pP $(PUBLIC_APPS_PATH)/ipsec-tools-0.8.2/src/racoon/.libs/lib*.so* $(FS_TG_PATH)/lib/
	cp -pP $(PUBLIC_APPS_PATH)/ipsec-tools-0.8.2/src/libipsec/.libs/lib*.so* $(FS_TG_PATH)/lib/
	cp -pP $(PUBLIC_APPS_PATH)/ipsec-tools-0.8.2/src/racoon/.libs/racoon* $(FS_TG_PATH)/usr/bin
	cp -pP $(PUBLIC_APPS_PATH)/ipsec-tools-0.8.2/src/setkey/.libs/setkey $(FS_TG_PATH)/usr/bin
ipsectools_clean:
	-cd $(PUBLIC_APPS_PATH)/ipsec-tools-0.8.2 && test -e Makefile && $(MAKE) clean && rm -f Makefile
ipsectools_ver:
	echo "ipsec-tools version : 0.8.2" >> $(BBA_PRODUCT_VER_FILE)

lzo:
	cd $(PUBLIC_APPS_PATH)/lzo-2.09 && test -e Makefile || \
	./configure --host=$(HOST) --prefix=$(PUBLIC_APPS_PATH)/lzo-2.09/install \
	--enable-shared CFLAGS="-Wall -Werror=implicit-function-declaration"
	cd $(PUBLIC_APPS_PATH)/lzo-2.09 && $(MAKE) install-strip
lzo_install:
	cp -P $(PUBLIC_APPS_PATH)/lzo-2.09/install/lib/*.so* $(FS_TG_PATH)/lib/
lzo_clean:
	-cd $(PUBLIC_APPS_PATH)/lzo-2.09 && test -e Makefile && $(MAKE) clean && rm -f Makefile
	-cd $(PUBLIC_APPS_PATH)/lzo-2.09 && rm -rf ./install
lzo_ver:
	echo "lzo version : 2.09" >> $(BBA_PRODUCT_VER_FILE)

ifneq ($(strip $(INCLUDE_MTK)),)
OPENVPN_EXTRA_CONFIG= -lpthread -ldl
endif
openvpn: lzo
	cd $(PUBLIC_APPS_PATH)/openvpn-2.4.8 && test -e Makefile || ( aclocal && autoreconf -if && \
		./configure --host=$(HOST) --prefix=$(PUBLIC_APPS_PATH)/openvpn-2.4.8/install \
		IFCONFIG=/sbin/ifconfig ROUTE=/sbin/route IPROUTE=/usr/bin/ip NETSTAT=/bin/netstat \
		--enable-small --disable-selinux --disable-systemd --disable-plugins --disable-debug \
		--disable-pkcs11 --enable-management \
		--enable-lzo --disable-x509-alt-username --enable-fragment --disable-iproute2 \
		--enable-pf --enable-crypto --with-crypto-library=openssl \
		CFLAGS="-Wall -Werror=implicit-function-declaration" \
		PKG_CONFIG_LIBDIR="$(PUBLIC_APPS_PATH)/$(INCLUDE_SSL_LIB_NAME)/install/lib/pkgconfig" \
		OPENSSL_CFLAGS="-I$(PUBLIC_APPS_PATH)/$(INCLUDE_SSL_LIB_NAME)/install/include" \
		OPENSSL_LIBS="-L$(PUBLIC_APPS_PATH)/$(INCLUDE_SSL_LIB_NAME)/install/lib -lssl -lcrypto $(OPENVPN_EXTRA_CONFIG)" \
		LZO_CFLAGS="-I$(PUBLIC_APPS_PATH)/lzo-2.09/install/include" \
		LZO_LIBS="-L$(PUBLIC_APPS_PATH)/lzo-2.09/install/lib -llzo2" )
	cd $(PUBLIC_APPS_PATH)/openvpn-2.4.8 && $(MAKE) install

openvpn_install:
	cp -pr $(PUBLIC_APPS_PATH)/openvpn-2.4.8/easy-rsa $(FS_TG_PATH)/etc
	cp -p $(PUBLIC_APPS_PATH)/openvpn-2.4.8/install/sbin/openvpn $(FS_TG_PATH)/usr/sbin
	cd $(FS_TG_PATH) && ln -sf /var/tmp/.rnd ./etc/.rnd
openvpn_clean:
	-cd $(PUBLIC_APPS_PATH)/openvpn-2.4.8 && test -e Makefile && $(MAKE) clean && rm -f Makefile
	-cd $(PUBLIC_APPS_PATH)/openvpn-2.4.8 && rm -rf ./install
openvpn_ver:
	echo "openvpn version : 2.09" >> $(BBA_PRODUCT_VER_FILE)

##### added by CCy for vpn, 20150630  #####
#because --sbindir is used for program when running, do not define --prefix and do not $(MAKE) install,
# or else install will install in the wrong directory.
pptpd:
	cd $(PUBLIC_APPS_PATH)/accel-pptpd && test -e Makefile || ./configure --host=$(HOST) \
		ac_cv_header_libintl_h=no --sbindir=/usr/sbin --enable-bcrelay \
		CFLAGS="-Wall -Werror=implicit-function-declaration"
	cd $(PUBLIC_APPS_PATH)/accel-pptpd && $(MAKE) PPPD_PPTP_INCLUDED=1 
pptpd_install:
	cp -p $(PUBLIC_APPS_PATH)/accel-pptpd/bcrelay $(FS_TG_PATH)/usr/sbin
	cp -p $(PUBLIC_APPS_PATH)/accel-pptpd/pptpctrl $(FS_TG_PATH)/usr/sbin
	cp -p $(PUBLIC_APPS_PATH)/accel-pptpd/pptpd $(FS_TG_PATH)/usr/sbin
	cp -p $(PUBLIC_APPS_PATH)/accel-pptpd/config/options.pptpd $(FS_TG_PATH)/etc/ppp
	cd $(FS_TG_PATH) && ln -sf /var/pptpd/chap-secrets ./etc/ppp/chap-secrets
pptpd_clean:
	-cd $(PUBLIC_APPS_PATH)/accel-pptpd && test -e Makefile && $(MAKE) clean && rm -f Makefile
pptpd_ver:
	echo "accel-pptpd version : 1.3.3" >> $(BBA_PRODUCT_VER_FILE)


