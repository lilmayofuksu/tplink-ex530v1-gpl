####################################################
#
#Build public apps
#
####################################################
export OS_LIB_PATH = $(PUBLIC_APPS_PATH)/os_libs
CURL_VER=curl-7.62.0
export CURL_DIR=$(PUBLIC_APPS_PATH)/$(CURL_VER)

export PUB_APPS =
ARCH_CFLAGS =
ifeq ($(INCLUDE_ECONET), y)
ARCH_CFLAGS += -DINCLUDE_ECONET
endif
ifeq ($(INCLUDE_QUALCOMM), y)
ARCH_CFLAGS += -DINCLUDE_QUALCOMM
endif
ifeq ($(INCLUDE_BROADCOM), y)
ARCH_CFLAGS += -DINCLUDE_BROADCOM
endif
ifeq ($(INCLUDE_MUSL_LIBC), y)
ARCH_CFLAGS += -DINCLUDE_MUSL_LIBC
endif

PUB_APPS += oslibs
ifneq ($(strip $(INCLUDE_DSL_BR2684CTL)),)
PUB_APPS += br2684ctl
endif
PUB_APPS += busybox
PUB_APPS += tc
PUB_APPS += iptables

ifeq ($(strip $(INCLUDE_PON_MTK)),)
PUB_APPS += ebtables
endif

ifeq ($(strip $(INCLUDE_ECONET_MT7513)), y)
PUB_APPS += ebtables
endif

PUB_APPS += pppd

ifneq ($(strip $(INCLUDE_ECONET)),)
ifneq ($(strip $(INCLUDE_ADSLWAN)),)
PUB_APPS += arpd
endif
endif

PUB_APPS += upnplib
PUB_APPS += upnp

ifneq ($(strip $(INCLUDE_DNS_PROXY)),)
PUB_APPS += dnsmasq
endif
ifneq ($(strip $(INCLUDE_SSL))$(strip $(INCLUDE_LIFEMOTE))$(strip $(INCLUDE_QUANTWIFI)),)
#openssl should before pjsip case pjsip need it
PUB_APPS += openssl
endif

ifneq ($(strip $(INCLUDE_VOIP)),)
PUB_APPS += pjsip
endif

ifneq ($(strip $(INCLUDE_RIP)),)
PUB_APPS += rip
endif

ifneq ($(strip $(INCLUDE_IPV6)),)
PUB_APPS += flex
PUB_APPS += radvd
PUB_APPS += dhcpv6
PUB_APPS += map_util
PUB_APPS += ividns
ifneq ($(strip $(INCLUDE_LTEWAN)),)
PUB_APPS += npd6
endif
endif

ifneq ($(strip $(INCLUDE_IPV6)$(INCLUDE_WAN_PORT_BINDING)),)
PUB_APPS += ip
endif

ifneq ($(strip $(INCLUDE_USB_SAMBA_SERVER)),)
#for samba and ntfs-3g, zjj, 20111129
#modified by LY on 2015.01.28, as ntfs-3g is not needed when use tntfs.ko provided by Tuxera
PUB_APPS += samba
endif

ifneq ($(strip $(INCLUDE_USB_STORAGE)),)
ifneq ($(strip $(INCLUDE_USB_STORAGE_TUXERA_NTFS)),y)
#modified by LY on 2015.01.28, as ntfs-3g is not needed when use tntfs.ko provided by Tuxera
PUB_APPS += ntfs-3g
endif
endif

ifneq ($(strip $(INCLUDE_USB_OVER_IP_TPLINK)),)
PUB_APPS += usbip
endif

ifneq ($(strip $(INCLUDE_USB_FTP_SERVER)),)
PUB_APPS += vsftp
endif

ifneq ($(strip $(INCLUDE_USB_MEDIA_SERVER)),)
#for mediaServer, modify by zengdongbiao, 21May15.
export MEDIA_SERVER_PATH = $(PUBLIC_APPS_PATH)/media_server
export MEDIA_SERVER_INSTALL=$(MEDIA_SERVER_PATH)/media_server_install
PUB_APPS += dlna
endif

ifneq ($(strip $(INCLUDE_USB_SFTP_SERVER)),)
PUB_APPS += openssh
endif

ifneq ($(strip $(INCLUDE_STORAGE_HTTP_SERVICE)),)
PUB_APPS += nginx
endif

ifneq ($(strip $(INCLUDE_IPSEC)),)
# added by CCy for vpn, 20150630
PUB_APPS += ipsectools
endif

ifneq ($(strip $(INCLUDE_USB_3G_DONGLE))$(strip $(INCLUDE_LTEWAN)),)
PUB_APPS += chat
#libusb&libcompat should before handle_card&usb_modeswitch
ifneq ($(strip $(filter y, $(INCLUDE_USB_3G_DONGLE) $(INCLUDE_USB_SYSFS))),)
PUB_APPS += libusb
PUB_APPS += libcompat
PUB_APPS += usb_modeswitch
endif
endif

ifneq ($(strip $(INCLUDE_L2TP)),)
PUB_APPS += xl2tpd
endif

ifneq ($(strip $(INCLUDE_PORTABLE_APP)),)
PUB_APPS += dropbear
else
ifneq ($(strip $(INCLUDE_SSH_ACCESS)),)
PUB_APPS += dropbear
endif
endif

ifneq ($(strip $(INCLUDE_TCPDUMP)),)
PUB_APPS += tcpdump
PUB_APPS += libpcap
endif

ifneq ($(strip $(INCLUDE_PACKET_CAPTURE)),)
PUB_APPS += libpcap1.8
endif

ifneq ($(strip $(INCLUDE_OPENVPN_SERVER)),)
PUB_APPS += lzo
PUB_APPS += openvpn
endif

ifneq ($(strip $(INCLUDE_PPTPVPN_SERVER)),)
PUB_APPS += pptpd
endif

ifneq ($(strip $(INCLUDE_STRACE)),)
ifneq ($(strip $(INCLUDE_PON_GPON)$(INCLUDE_MTK)$(INCLUDE_ECONET_MT7513)),)
PUB_APPS += strace4
else
PUB_APPS += strace
endif
endif

ifneq ($(strip $(INCLUDE_VALGRIND)),)
PUB_APPS += valgrind
endif

ifneq ($(strip $(INCLUDE_PRLIMIT)),)
PUB_APPS += prlimit
endif

ifneq ($(strip $(INCLUDE_ONEMESH)),)
PUB_APPS += libssh
endif

ifneq ($(strip $(INCLUDE_LTEWAN)),)
PUB_APPS += libsqlite
PUB_APPS += libcjson
PUB_APPS += zlib
PUB_APPS += e2fsprogs
PUB_APPS += ubitools
PUB_APPS += mbedtls
endif

ifneq ($(strip $(INCLUDE_LTE_SUPPORT_ADB)),)
PUB_APPS += adb
PUB_APPS += zlib
endif

ifneq ($(strip $(INCLUDE_LTEWAN_TEST)),)
PUB_APPS += libjsonc
PUB_APPS += libubox
PUB_APPS += uqmi
endif

ifneq ($(strip $(INCLUDE_CLOUD)$(INCLUDE_LIFEMOTE))$(INCLUDE_QUANTWIFI)), )
PUB_APPS += curl
endif

ifneq ($(strip $(INCLUDE_EASYMESH)),)
PUB_APPS += libjsonc
PUB_APPS += libubox
endif

ifneq ($(strip $(INCLUDE_TR369)),)
PUB_APPS += cJSON
PUB_APPS += mosquitto
PUB_APPS += zlib
endif

ifeq ($(INCLUDE_TR143_GRO),y)
PUB_APPS += ethtool
endif

ifeq ($(INCLUDE_LIFEMOTE),y)
PUB_APPS += lifemote
endif

ifneq ($(strip $(INCLUDE_UDPXY)),)
PUB_APPS += udpxy
endif

ifeq ($(INCLUDE_CONTAINER),y)
PUB_APPS += zlib
PUB_APPS += e2fsprogs
PUB_APPS += ubitools
PUB_APPS += libiconv
PUB_APPS += libffi
PUB_APPS += gettext
PUB_APPS += glib
PUB_APPS += lxc
PUB_APPS += opkg
PUB_APPS += expat
PUB_APPS += dbus
endif

ifeq ($(INCLUDE_SMART_HOME_V2),y)
PUB_APPS += zlib
PUB_APPS += e2fsprogs
PUB_APPS += ubitools
#PUB_APPS += libiconv
#PUB_APPS += libffi
#PUB_APPS += gettext
#PUB_APPS += glib
PUB_APPS += lxc
PUB_APPS += opkg
#PUB_APPS += expat
#PUB_APPS += dbus
endif

ifeq ($(INCLUDE_QUANTWIFI),y)
PUB_APPS += quantwifi
endif

ifeq ($(INCLUDE_USB),y)
ifeq ($(INCLUDE_MTK_CHIP_MT7986),y)
PUB_APPS += udevtrigger
endif
endif

ifneq ($(strip $(INCLUDE_REALTEK)),)
PUB_APPS += libjsonc
PUB_APPS += libubox
PUB_APPS += uci
endif

ifeq ($(INCLUDE_IPERF3),y)
PUB_APPS += iperf3
endif

PUB_APPS_INSTALL = $(addsuffix _install,$(PUB_APPS))
PUB_APPS_CLEAN = $(addsuffix _clean,$(PUB_APPS))
PUB_APPS_VER = $(addsuffix _ver,$(PUB_APPS))


###############################################################################
# Target Label Hooking
###############################################################################

.PHONY: $(PUB_APPS) $(PUB_APPS_INSTALL) $(PUB_APPS_CLEAN) $(PUB_APPS_VER)

public_apps_build: $(PUB_APPS)
public_apps_install: $(PUB_APPS_INSTALL)
public_apps_clean: $(PUB_APPS_CLEAN)
public_apps_ver: $(PUB_APPS_VER)

###############################################################################

libpcap:
	cd $(PUBLIC_APPS_PATH)/libpcap-1.1.1 && test -e Makefile || ./configure --with-pcap=linux \
		--host=$(HOST) --enable-static CFLAGS="-Wall -Werror=implicit-function-declaration"
	cd $(PUBLIC_APPS_PATH)/libpcap-1.1.1 && $(MAKE)
libpcap_install:
	
libpcap_clean:
	-cd $(PUBLIC_APPS_PATH)/libpcap-1.1.1 && test -e Makefile && $(MAKE) clean && rm -f Makefile
libpcap_ver:
	echo "libpcap version : 1.1.1" >> $(BBA_PRODUCT_VER_FILE)

libpcap1.8:
	cd $(PUBLIC_APPS_PATH)/libpcap-1.8.1 && test -e Makefile || ./configure --with-pcap=linux \
		--host=$(HOST) --enable-static CFLAGS="-Wall -Werror=implicit-function-declaration" \
		--prefix=$(PUBLIC_APPS_PATH)/libpcap-1.8.1/install
	cd $(PUBLIC_APPS_PATH)/libpcap-1.8.1 && $(MAKE) && $(MAKE) install
libpcap1.8_install:
	cd $(PUBLIC_APPS_PATH)/libpcap-1.8.1/install/lib && cp -p libpcap.so.1.8.1 $(FS_TG_PATH)/lib/
	cd $(FS_TG_PATH)/lib/ && ln -sf libpcap.so.1.8.1 libpcap.so.1 && ln -s libpcap.so.1 libpcap.so
libpcap1.8_clean:
	-cd $(PUBLIC_APPS_PATH)/libpcap-1.8.1 && test -e Makefile && $(MAKE) clean && rm -f Makefile
libpcap1.8_ver:
	echo "libpcap version : 1.8.1" >> $(BBA_PRODUCT_VER_FILE)


tcpdump: libpcap
	cd $(PUBLIC_APPS_PATH)/tcpdump-4.3.0 && test -e Makefile || ./configure --host=$(HOST) \
		--without-crypto --disable-shared CFLAGS="-Wall -Werror=implicit-function-declaration"
	cd $(PUBLIC_APPS_PATH)/tcpdump-4.3.0 && $(MAKE) && $(STRIP) $@ && ls -l $@
tcpdump_install:
	cp -p $(PUBLIC_APPS_PATH)/tcpdump-4.3.0/tcpdump $(FS_TG_PATH)/usr/sbin
tcpdump_clean: libpcap_clean
	-cd $(PUBLIC_APPS_PATH)/tcpdump-4.3.0 && test -e Makefile && $(MAKE) clean && rm -f Makefile
tcpdump_ver:
	echo "tcpdump version : 4.3.0" >> $(BBA_PRODUCT_VER_FILE)

				
oslibs: model_init
	cd $(PUBLIC_APPS_PATH)/os_libs && $(MAKE)
oslibs_install:
	cp -P $(OS_LIB_PATH)/libos.so $(FS_TG_PATH)/lib
oslibs_clean:
	$(MAKE) -C $(PUBLIC_APPS_PATH)/os_libs clean
oslibs_ver:
	echo "oslibs version : 1.0.0" >> $(BBA_PRODUCT_VER_FILE)


busybox_menu_pre:
	cp -pf $(MODEL_PATH)/config.busybox $(PUBLIC_APPS_PATH)/busybox-1.23.2/.config
busybox_menuconfig: busybox_menu_pre
	cd $(PUBLIC_APPS_PATH)/busybox-1.23.2 && $(MAKE) menuconfig
	cp -pf $(PUBLIC_APPS_PATH)/busybox-1.23.2/.config $(MODEL_PATH)/config.busybox

busybox:
ifeq ($(strip $(INCLUDE_BCM_BUSYBOX_32BIT)), y)
	# force build 32bit executable busybox on 64bit kernel system.
	$(MAKE) busybox_inner
else
	CURRENT_ARCH=$(KERNEL_ARCH) TOOLCHAIN_TOP= $(MAKE) busybox_inner
endif
busybox_install:
ifeq ($(strip $(INCLUDE_BCM_BUSYBOX_32BIT)), y)
	# force build 32bit executable busybox on 64bit kernel system.
	$(MAKE) busybox_install_inner
else
	CURRENT_ARCH=$(KERNEL_ARCH) TOOLCHAIN_TOP= $(MAKE) busybox_install_inner
endif
busybox_clean:
ifeq ($(strip $(INCLUDE_BCM_BUSYBOX_32BIT)), y)
	# force build 32bit executable busybox on 64bit kernel system.
	$(MAKE) busybox_clean_inner
else
	CURRENT_ARCH=$(KERNEL_ARCH) TOOLCHAIN_TOP= $(MAKE) busybox_clean_inner
endif
busybox_ver:
	echo "busybox version : 1.23.2" >> $(BBA_PRODUCT_VER_FILE)
	
busybox_inner: busybox_menu_pre
	cd $(PUBLIC_APPS_PATH)/busybox-1.23.2 && $(MAKE) CFLAGS="-Wall -Werror=implicit-function-declaration"
busybox_install_inner:
	cd $(PUBLIC_APPS_PATH)/busybox-1.23.2 && $(MAKE) install CONFIG_PREFIX=$(FS_TG_PATH)
busybox_clean_inner:
	$(MAKE) -C $(PUBLIC_APPS_PATH)/busybox-1.23.2 clean

strace:
	cd $(PUBLIC_APPS_PATH)/strace-5.12 && test -e configure || ./bootstrap
	cd $(PUBLIC_APPS_PATH)/strace-5.12 && test -e Makefile || ./configure --host=$(HOST) --enable-mpers=no
	cd $(PUBLIC_APPS_PATH)/strace-5.12 && $(MAKE)
	cd $(PUBLIC_APPS_PATH)/strace-5.12/src && $(STRIP) strace
strace_install:
	cp -p $(PUBLIC_APPS_PATH)/strace-5.12/src/strace $(FS_TG_PATH)/usr/bin
strace_clean:
	$(MAKE) -C $(PUBLIC_APPS_PATH)/strace-5.12 clean
strace_ver:
	echo "strace version : 5.12" >> $(BBA_PRODUCT_VER_FILE)

strace4:
	cd $(PUBLIC_APPS_PATH)/strace-4.8 && test -e Makefile || ./configure --host=$(HOST)
	cd $(PUBLIC_APPS_PATH)/strace-4.8 && $(MAKE) && $(STRIP) strace

strace4_install:
	cp -p $(PUBLIC_APPS_PATH)/strace-4.8/strace $(FS_TG_PATH)/usr/bin
strace4_clean:
	$(MAKE) -C $(PUBLIC_APPS_PATH)/strace-4.8 clean
strace4_ver:
	echo "strace version : 4.8" >> $(BBA_PRODUCT_VER_FILE)

tc:
ifeq ($(strip $(INCLUDE_BCM_TC_TOOL_32BIT)), y)
	# force build 32bit executable tc tool on 64bit kernel system.
	$(MAKE) tc_inner
else
	CURRENT_ARCH=$(KERNEL_ARCH) TOOLCHAIN_TOP= $(MAKE) tc_inner
endif
	
tc_inner:
	# kernel version > 3.4
	cd $(PUBLIC_APPS_PATH)/iproute2-2.6.39 && $(MAKE)

tc_install:
	cp -p $(PUBLIC_APPS_PATH)/iproute2-2.6.39/tc/tc $(FS_TG_PATH)/usr/bin
tc_clean:
	$(MAKE) -C $(PUBLIC_APPS_PATH)/iproute2-2.6.39 clean
tc_ver:
	echo "tc version : 2.6.39" >> $(BBA_PRODUCT_VER_FILE)

dnsmasq:
	if [ ! -e $(PUBLIC_APPS_PATH)/dnsmasq-2.85/Makefile ]; then \
		cd $(PUBLIC_APPS_PATH)/dnsmasq-2.85 && ./configure --host=$(HOST); \
	fi; \
	sed -i "s/COPTS\ \ \ \ \ \ \ \ \ \=.*/COPTS\ \ \ \ \ \ \ \ \ \=\ \-DNO_DHCP\ \-DNO_TFTP\ \-DNO_DBUS\ \-DNO_LOG\ \-DNO_SCRIPT\ \-DNO_IPSET\ \-DNO_INOTIFY/" $(PUBLIC_APPS_PATH)/dnsmasq-2.85/Makefile; \
	cd $(PUBLIC_APPS_PATH)/dnsmasq-2.85 && $(MAKE)
dnsmasq_install:
	cp -p $(PUBLIC_APPS_PATH)/dnsmasq-2.85/src/dnsmasq $(FS_TG_PATH)/usr/sbin
dnsmasq_clean:
	$(MAKE) -C $(PUBLIC_APPS_PATH)/dnsmasq-2.85 clean
dnsmasq_ver:
	echo "dnsmasq version : 2.85" >> $(BBA_PRODUCT_VER_FILE)

ifneq ($(strip $(INCLUDE_BCM_IPTABLES)),)
else	
iptables:
	cd $(PUBLIC_APPS_PATH)/iptables-1.4.17 && test -e Makefile || \
		./configure --host=$(HOST) --enable-static --disable-shared \
		CFLAGS="$(ARCH_CFLAGS) -Wall -Werror=implicit-function-declaration"
	cd $(PUBLIC_APPS_PATH)/iptables-1.4.17 && $(MAKE) AR=$(TOOLPREFIX)ar
	$(STRIP) $(PUBLIC_APPS_PATH)/iptables-1.4.17/iptables/xtables-multi
iptables_install:
	cp -p $(PUBLIC_APPS_PATH)/iptables-1.4.17/iptables/xtables-multi $(FS_TG_PATH)/usr/bin
	cd $(FS_TG_PATH)/usr/bin && ln -sf xtables-multi iptables
ifeq ($(INCLUDE_IPV6), y)
	cd $(FS_TG_PATH)/usr/bin && ln -sf xtables-multi ip6tables
endif
iptables_clean:
	-cd $(PUBLIC_APPS_PATH)/iptables-1.4.17 && test -e Makefile && $(MAKE) clean && rm -f Makefile
iptables_ver:
	echo "dnsmasq version : 1.4.17" >> $(BBA_PRODUCT_VER_FILE)
endif

ebtables:
ifeq ($(strip $(INCLUDE_BCM_EBTABLES_32BIT)), y)
	# force build 32bit executable ebtables on 64bit kernel system.
	$(MAKE) ebtables_inner
else
	CURRENT_ARCH=$(KERNEL_ARCH) TOOLCHAIN_TOP= $(MAKE) ebtables_inner
endif
	
ebtables_inner:
	cd $(PUBLIC_APPS_PATH)/ebtables-v2.0.10-4 && $(MAKE) static
ebtables_install:
	cp -p $(PUBLIC_APPS_PATH)/ebtables-v2.0.10-4/ebtables $(FS_TG_PATH)/usr/bin
	cp -p $(PUBLIC_APPS_PATH)/ebtables-v2.0.10-4/ethertypes $(FS_TG_PATH)/etc/
ebtables_clean:
	$(MAKE) -C $(PUBLIC_APPS_PATH)/ebtables-v2.0.10-4 clean
ebtables_ver:
	echo "ebtables version : 2.0.10-4" >> $(BBA_PRODUCT_VER_FILE)


pppd: openssl
ifeq ($(INCLUDE_PPTPVPN_SERVER), y)
	cd $(PUBLIC_APPS_PATH)/ppp-2.4.5/pppd && export DF_FLAGS; $(MAKE) MPPE=y #INCLUDE_IPV6_PPPV6=$(INCLUDE_IPV6_PPPV6)
else
	cd $(PUBLIC_APPS_PATH)/ppp-2.4.5/pppd && export DF_FLAGS; $(MAKE) #INCLUDE_IPV6_PPPV6=$(INCLUDE_IPV6_PPPV6)
endif
pppd_install:
	cp -p $(PUBLIC_APPS_PATH)/ppp-2.4.5/pppd/pppd $(FS_TG_PATH)/usr/sbin
pppd_clean:
	$(MAKE) -C $(PUBLIC_APPS_PATH)/ppp-2.4.5/pppd clean
pppd_ver:
	echo "ppp version : 2.4.5" >> $(BBA_PRODUCT_VER_FILE)


arpd:
	cd $(PUBLIC_APPS_PATH)/linux-atm && $(MAKE)
arpd_install:
	cp -p $(PUBLIC_APPS_PATH)/linux-atm/arpd/atmarp $(FS_TG_PATH)/usr/sbin
	cp -p $(PUBLIC_APPS_PATH)/linux-atm/arpd/atmarpd $(FS_TG_PATH)/usr/sbin
arpd_clean:
	$(MAKE) -C $(PUBLIC_APPS_PATH)/linux-atm clean
arpd_ver:
	echo "linux-atm version : 0.78" >> $(BBA_PRODUCT_VER_FILE)


ifeq ($(INCLUDE_MUSL_LIBC), y)
LIBUPNP_CFLAGS += -DINCLUDE_MUSL_LIBC 
endif
ifneq ($(strip $(INCLUDE_REAL_NAME_DEFAULT_BRIDGE)),)
LIBUPNP_CFLAGS += -DINCLUDE_REAL_NAME_DEFAULT_BRIDGE=$(INCLUDE_REAL_NAME_DEFAULT_BRIDGE)
endif
upnplib:
	export CFLAGS+="$(LIBUPNP_CFLAGS)" ; \
	$(MAKE) -C $(PUBLIC_APPS_PATH)/upnp_libs
upnplib_install:
	cp -P $(PUBLIC_APPS_PATH)/upnp_libs/*.so $(FS_TG_PATH)/lib/
upnplib_clean:
	$(MAKE) -C $(PUBLIC_APPS_PATH)/upnp_libs clean
upnplib_ver:
	echo "upnp_libs version : 1.6.18" >> $(BBA_PRODUCT_VER_FILE)


upnp:
	$(MAKE) -C $(PUBLIC_APPS_PATH)/IGD
upnp_install:
	cp -p $(PUBLIC_APPS_PATH)/IGD/upnpd $(FS_TG_PATH)/usr/bin
upnp_clean:
	$(MAKE) -C $(PUBLIC_APPS_PATH)/IGD clean
upnp_ver:
	echo "IGD version : 1.0.0" >> $(BBA_PRODUCT_VER_FILE)


rip:
	cd $(PUBLIC_APPS_PATH)/zebra-0.95a && test -e Makefile || \
		./configure --host=$(HOST) --disable-bgpd --disable-ospfd --disable-ospf6d --no-recursion \
		CFLAGS="-Wall -Werror=implicit-function-declaration"
	$(MAKE) -C $(PUBLIC_APPS_PATH)/zebra-0.95a
rip_install:
	cp -p $(PUBLIC_APPS_PATH)/zebra-0.95a/ripd/ripd $(FS_TG_PATH)/usr/sbin
	cp -p $(PUBLIC_APPS_PATH)/zebra-0.95a/ripngd/ripngd $(FS_TG_PATH)/usr/sbin
	cp -p $(PUBLIC_APPS_PATH)/zebra-0.95a/zebra/zebra $(FS_TG_PATH)/usr/sbin
rip_clean:
	-cd $(PUBLIC_APPS_PATH)/zebra-0.95a && test -e Makefile && $(MAKE) clean && rm -f Makefile
rip_ver:
	echo "zebra version : 0.95a" >> $(BBA_PRODUCT_VER_FILE)

br2684ctl:
	cd $(PUBLIC_APPS_PATH)/br2684ctl && $(MAKE)
br2684ctl_install:
	cp -p $(PUBLIC_APPS_PATH)/br2684ctl/br2684ctl $(FS_TG_PATH)/usr/bin 
br2684ctl_clean:
	$(MAKE) -C $(PUBLIC_APPS_PATH)/br2684ctl clean
br2684ctl_ver:
	echo "br2684ctl version : 1.0.0" >> $(BBA_PRODUCT_VER_FILE)

pjsip:
	cd $(PUBLIC_APPS_PATH)/pjsip_1.10 && test -e build.mak || \
	( export CPPFLAGS+="-Wall -Werror=implicit-function-declaration "; \
	  ./configure --cache-file=./config_cache_file --srcdir=./ \
	  --prefix=$(TOOLROOTPATH) --exec-prefix=$(TOOLROOTPATH) --host=$(HOST) --disable-speex-aec \
	  --disable-l16-codec --disable-gsm-codec --disable-speex-codec --disable-ilbc-codec --disable-g7221-codec \
	  --disable-ssl --disable-oss --disable-sound; \
	)
	cd $(PUBLIC_APPS_PATH)/pjsip_1.10 && $(MAKE)

pjsip_install:
	cp $(APP_PJSIP_DIR)/pjsip-apps/bin/pjsua $(FS_TG_PATH)/usr/bin
ifneq ($(strip $(INCLUDE_USB_VOICEMAIL)),)
	cp $(APP_PJSIP_DIR)/usbvm/lib/libusbvmcommon.so $(FS_TG_PATH)/lib/
endif
pjsip_clean:
	-cd $(PUBLIC_APPS_PATH)/pjsip_1.10 && test -e build.mak && $(MAKE) clean && rm -f build.mak
pjsip_ver:
	echo "pjsip version : 1.10" >> $(BBA_PRODUCT_VER_FILE)

usbip:
	$(MAKE) -C $(PUBLIC_APPS_PATH)/usbip-0.1.7 clean
	cd $(PUBLIC_APPS_PATH)/usbip-0.1.7 && $(MAKE)
usbip_install:
	cp -p $(PUBLIC_APPS_PATH)/usbip-0.1.7/usbipd $(FS_TG_PATH)/usr/bin
usbip_clean:
	$(MAKE) -C $(PUBLIC_APPS_PATH)/usbip-0.1.7 clean
usbip_ver:
	echo "usbip version : 0.1.7" >> $(BBA_PRODUCT_VER_FILE)


vsftp:
	cd $(PUBLIC_APPS_PATH)/vsftpd-2.3.2 && $(MAKE)
vsftp_install:
	cp -p $(PUBLIC_APPS_PATH)/vsftpd-2.3.2/vsftpd $(FS_TG_PATH)/usr/bin
	cp -p $(PUBLIC_APPS_PATH)/vsftpd-2.3.2/vsftpd.conf $(FS_TG_PATH)/etc
vsftp_clean:
	$(MAKE) -C $(PUBLIC_APPS_PATH)/vsftpd-2.3.2 clean
vsftp_ver:
	echo "vsftpd version : 2.3.2" >> $(BBA_PRODUCT_VER_FILE)

ifneq ($(strip $(INCLUDE_ARM64)),)
NGINX_CC_OPT='-DNGX_PTR_SIZE=8 -DNGX_SIG_ATOMIC_T_SIZE=4 -DNGX_MAX_SIZE_T_VALUE=9223372036854775807LL -DNGX_SIZE_T_LEN=20 -DNGX_MAX_OFF_T_VALUE=9223372036854775807LL -DNGX_OFF_T_LEN=20 -DNGX_TIME_T_SIZE=8 -DNGX_TIME_T_LEN=20 -DNGX_MAX_TIME_T_VALUE=9223372036854775807LL'
else
NGINX_CC_OPT='-DNGX_PTR_SIZE=4 -DNGX_SIG_ATOMIC_T_SIZE=4 -DNGX_MAX_SIZE_T_VALUE=2147483647 -DNGX_SIZE_T_LEN=11 -DNGX_MAX_OFF_T_VALUE=2147483647 -DNGX_OFF_T_LEN=11 -DNGX_TIME_T_SIZE=4 -DNGX_TIME_T_LEN=11 -DNGX_MAX_TIME_T_VALUE=2147483647'
endif
nginx: openssl
	cd $(PUBLIC_APPS_PATH)/nginx-1.22.0 && test -e Makefile || \
		./configure --with-cc=$(CC) \
		--with-cc-opt=$(NGINX_CC_OPT) \
		--with-openssl=$(PUBLIC_APPS_PATH)/$(INCLUDE_SSL_LIB_NAME)/install \
		--with-zlib=$(PUBLIC_APPS_PATH)/media_server/zlib-1.2.6 \
		--prefix=/var/nginx \
		--without-pcre \
		--without-http_ssi_module \
		--without-http_access_module \
		--without-http_geo_module \
		--without-http_map_module \
		--without-http_rewrite_module \
		--without-http_proxy_module \
		--without-http_fastcgi_module \
		--without-http_uwsgi_module \
		--without-http_scgi_module \
		--without-http_memcached_module \
		--without-http_upstream_ip_hash_module \
		--without-http_upstream_hash_module \
		--without-http_upstream_least_conn_module \
		--without-http_upstream_keepalive_module \
		--without-mail_pop3_module \
		--without-mail_imap_module \
		--without-mail_smtp_module \
		--without-http_split_clients_module \
		--without-http_userid_module \
		--without-http_limit_conn_module \
		--without-http_limit_req_module \
		--without-http_empty_gif_module \
		--without-http_browser_module \
		--with-http_ssl_module && $(MAKE)
