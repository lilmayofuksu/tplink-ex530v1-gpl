glib:
	cd $(PUBLIC_APPS_PATH)/glib-2.59.0  && ./autogen.sh
	rm -rf $(PUBLIC_APPS_PATH)/glib-2.59.0/glib.cache
	echo "glib_cv_stack_grows=no"> $(PUBLIC_APPS_PATH)/glib-2.59.0/glib.cache
	echo "glib_cv_uscore=no" >> $(PUBLIC_APPS_PATH)/glib-2.59.0/glib.cache
	echo "ac_cv_func_posix_getpwuid_r=no" >> $(PUBLIC_APPS_PATH)/glib-2.59.0/glib.cache
	echo "ac_cv_func_posix_getgrgid_r=no" >> $(PUBLIC_APPS_PATH)/glib-2.59.0/glib.cache

	#cp libs 
	-rm -rf $(PUBLIC_APPS_PATH)/container_libs
	mkdir -p $(PUBLIC_APPS_PATH)/container_libs
	cp -rf $(PUBLIC_APPS_PATH)/zlib-1.2.11/install/include $(PUBLIC_APPS_PATH)/container_libs
	cp -rf $(PUBLIC_APPS_PATH)/zlib-1.2.11/install/lib $(PUBLIC_APPS_PATH)/container_libs

	cp -rf $(PUBLIC_APPS_PATH)/libiconv-1.16/install/include $(PUBLIC_APPS_PATH)/container_libs
	cp -rf $(PUBLIC_APPS_PATH)/libiconv-1.16/install/lib $(PUBLIC_APPS_PATH)/container_libs

	cp -rf $(PUBLIC_APPS_PATH)/gettext-0.21/install/include $(PUBLIC_APPS_PATH)/container_libs
	cp -rf $(PUBLIC_APPS_PATH)/gettext-0.21/install/lib $(PUBLIC_APPS_PATH)/container_libs
	
	cp -rf $(PUBLIC_APPS_PATH)/libffi-3.4.2/install/include $(PUBLIC_APPS_PATH)/container_libs
	cp -rf $(PUBLIC_APPS_PATH)/libffi-3.4.2/install/lib $(PUBLIC_APPS_PATH)/container_libs

	cd $(PUBLIC_APPS_PATH)/glib-2.59.0 && \
	export LIBFFI_CFLAGS="-I$(PUBLIC_APPS_PATH)/libffi-3.4.2/install/include" && \
	export LIBFFI_LIBS="-L$(PUBLIC_APPS_PATH)/libffi-3.4.2/install/lib -lffi"  && \
	export CFLAGS="-I$(PUBLIC_APPS_PATH)/container_libs/include" && \
	export LDFLAGS="-L$(PUBLIC_APPS_PATH)/container_libs/lib -liconv -lpthread -ldl -lffi -lz" && \
	./configure  --host=$(HOST) \
	CC=$(CC) --prefix=$(PUBLIC_APPS_PATH)/glib-2.59.0/install \
	--with-pcre=internal --enable-libmount=no --with-libiconv=gnu \
	--cache-file=glib.cache --disable-selinux  --disable-xattr --disable-libelf

	cd $(PUBLIC_APPS_PATH)/glib-2.59.0	&& $(MAKE) V=99 && $(MAKE) install
	
glib_clean:
	cd $(PUBLIC_APPS_PATH)/glib-2.59.0 && $(MAKE) clean
glib_install:
	cp $(PUBLIC_APPS_PATH)/glib-2.59.0/install/lib/libgio-2.0.so.0.5900.0 $(FS_TG_PATH)/lib
	cd $(FS_TG_PATH)/lib/ && ln -sf libgio-2.0.so.0.5900.0 libgio-2.0.so.0
	
	cp $(PUBLIC_APPS_PATH)/glib-2.59.0/install/lib/libglib-2.0.so.0.5900.0 $(FS_TG_PATH)/lib
	cd $(FS_TG_PATH)/lib/ && ln -sf libglib-2.0.so.0.5900.0 libglib-2.0.so.0
	
	cp $(PUBLIC_APPS_PATH)/glib-2.59.0/install/lib/libgmodule-2.0.so.0.5900.0 $(FS_TG_PATH)/lib
	cd $(FS_TG_PATH)/lib/ && ln -sf libgmodule-2.0.so.0.5900.0 libgmodule-2.0.so.0
	
	cp $(PUBLIC_APPS_PATH)/glib-2.59.0/install/lib/libgobject-2.0.so.0.5900.0 $(FS_TG_PATH)/lib
	cd $(FS_TG_PATH)/lib/ && ln -sf libgobject-2.0.so.0.5900.0 libgobject-2.0.so.0
	
	cp $(PUBLIC_APPS_PATH)/glib-2.59.0/install/lib/libgthread-2.0.so.0.5900.0 $(FS_TG_PATH)/lib
	cd $(FS_TG_PATH)/lib/ && ln -sf libgthread-2.0.so.0.5900.0 libgthread-2.0.so.0
lxc:
	cd $(PUBLIC_APPS_PATH)/lxc-2.1.1 && ./autogen.sh && \
	rm -rf config.cache && \
	./configure  --host=$(HOST) --prefix=/usr \
	CC=$(CC) \
	LDFLAGS="-lpthread -ldl" \
	--disable-werror \
	--disable-apparmor \
	--disable-doc \
	--disable-api-docs \
	--disable-gnutls \
	--disable-selinux \
	--disable-cgmanager \
	--disable-examples \
	--disable-python \
	--disable-bash \
	--disable-lua \
	--disable-seccomp \
	--with-runtime-path="/tmp/run" ;\
	cd $(PUBLIC_APPS_PATH)/lxc-2.1.1 && make;

lxc_install:
	LXCDIR=$(PUBLIC_APPS_PATH)/lxc-2.1.1
	mkdir -p $(FS_TG_PATH)/usr/etc/lxc/;
	mkdir -p $(FS_TG_PATH)/etc/lxc/;
	cp -f $(PUBLIC_APPS_PATH)/lxc-2.1.1/config/etc/default.conf  $(FS_TG_PATH)/usr/etc/lxc/;
	cp -f $(PUBLIC_APPS_PATH)/lxc-2.1.1/config/etc/default.conf  $(FS_TG_PATH)/etc/lxc/;
	echo "lxc.lxcpath = /opt/upt/apps/LXC" > $(FS_TG_PATH)/usr/etc/lxc/lxc.conf;
	echo "lxc.lxcpath = /opt/upt/apps/LXC" > $(FS_TG_PATH)/etc/lxc/lxc.conf;
	mkdir -p $(FS_TG_PATH)/usr/share/lxc/templates
	mkdir -p $(FS_TG_PATH)/usr/lib;
	cp -f  $(PUBLIC_APPS_PATH)/lxc-2.1.1/src/lxc/lxc.functions $(FS_TG_PATH)/usr/share/lxc/;
	cp -av $(PUBLIC_APPS_PATH)/lxc-2.1.1/src/lxc/.libs/liblxc.so* $(FS_TG_PATH)/usr/lib/;
	cp -av $(PUBLIC_APPS_PATH)/lxc-2.1.1/src/lxc/.libs/lxc-* $(FS_TG_PATH)/usr/bin/;
	cp -av $(PUBLIC_APPS_PATH)/lxc-2.1.1/src/lxc/.libs/init.lxc $(FS_TG_PATH)/sbin/;
	cp -f $(PUBLIC_APPS_PATH)/lxc-2.1.1/mipsel-buildroot-linux-uclibc/usr/share/lxc/templates/lxc* $(FS_TG_PATH)/usr/share/lxc/templates
	chmod a+x $(FS_TG_PATH)/usr/share/lxc/templates/lxc*
	mkdir -p $(FS_TG_PATH)/usr/lib/lxc/rootfs
	
lxc_clean:
	- rm -rf $(FS_TG_PATH)/usr/etc/lxc
	- rm -rf $(FS_TG_PATH)/usr/share/lxc
	- rm -rf $(FS_TG_PATH)/usr/share/lib/liblxc.so*
	- rm -rf $(FS_TG_PATH)/usr/bin/lxc-*
	- rm -rf $(FS_TG_PATH)/sbin/init.lxc
	make -C $(PUBLIC_APPS_PATH)/lxc-2.1.1 clean

