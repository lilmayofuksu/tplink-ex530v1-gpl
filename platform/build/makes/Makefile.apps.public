ubitools:
	cd $(PUBLIC_APPS_PATH)/mtd-utils-1.5.1 && \
        $(MAKE) CROSS=$(TOOLPREFIX) WITHOUT_LZO=1 WITHOUT_XATTR=1 WITHOUT_XZ=1 \
		CFLAGS="-I$(PUBLIC_APPS_PATH)/e2fsprogs-1.47.0/lib -I$(PUBLIC_APPS_PATH)/zlib-1.2.11/install/include" \
		LDFLAGS="-L$(PUBLIC_APPS_PATH)/e2fsprogs-1.47.0/lib -luuid -L$(PUBLIC_APPS_PATH)/zlib-1.2.11/install/lib -lz" \
		BUILDDIR=$(PUBLIC_APPS_PATH)/mtd-utils-1.5.1 \
		TARGETS="flash_erase ubi-utils/ubiformat ubi-utils/ubiattach ubi-utils/ubidetach ubi-utils/ubimkvol ubi-utils/ubirmvol ubi-utils/ubinfo ubi-utils/ubirsvol mkfs.ubifs/mkfs.ubifs"
