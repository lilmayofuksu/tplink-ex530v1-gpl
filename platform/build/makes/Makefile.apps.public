ifeq ($(INCLUDE_MINIDLNA), y)
	cd $(PUBLIC_APPS_PATH)/media_server && $(MAKE) media_share 
	find $(MEDIA_SERVER_INSTALL)/lib -name "*.so*" -type f | xargs $(STRIP) --strip-unneeded
