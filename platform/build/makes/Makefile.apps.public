dlna: lzo
ifeq ($(INCLUDE_USHARE), y)
	$(MAKE) -C $(PUBLIC_APPS_PATH)/ffmpeg-0.6/
	$(MAKE) -C $(PUBLIC_APPS_PATH)/libdlna-0.2.3/
	$(MAKE) -C $(PUBLIC_APPS_PATH)/ushare-1.1a/
