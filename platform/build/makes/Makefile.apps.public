valgrind:
	cd $(PUBLIC_APPS_PATH)/valgrind-3.18.1 && ./configure --build=x86_64-linux --host=$(HOST) --prefix=/ --bindir=/bin --libexecdir=/lib CFLAGS="-ldl"
ifeq ($(findstring 4.3.6,$(TOOLROOTPATH)), 4.3.6)
	-cd $(PUBLIC_APPS_PATH)/valgrind-3.18.1/drd/ && cat Makefile | sed 's/^  -O2/  -O1/' > .out.mak && mv -f .out.mak Makefile
	-cd $(PUBLIC_APPS_PATH)/valgrind-3.18.1/VEX/priv/ && cat guest_mips_helpers.c | sed 's/(x) : :/(x) :/' > .guest_mips_helpers.c && mv .guest_mips_helpers.c guest_mips_helpers.c && rm -f .guest_mips_helpers.c
endif
	cd $(PUBLIC_APPS_PATH)/valgrind-3.18.1 && make
	cd $(PUBLIC_APPS_PATH)/valgrind-3.18.1 && make install DESTDIR=$(PUBLIC_APPS_PATH)/valgrind-3.18.1/install
#	$(STRIP) $(PUBLIC_APPS_PATH)/valgrind-3.18.1/install/bin/valgrind $(PUBLIC_APPS_PATH)/valgrind-3.18.1/install/lib/valgrind/memcheck-mips32-linux 
valgrind_clean:
	$(MAKE) -C $(PUBLIC_APPS_PATH)/valgrind-3.18.1 clean
valgrind_install:
	cp $(PUBLIC_APPS_PATH)/valgrind-3.18.1/install/bin/valgrind $(FS_TG_PATH)/usr/sbin
	mkdir -p $(FS_TG_PATH)/lib/valgrind
	cp $(PUBLIC_APPS_PATH)/valgrind-3.18.1/install/lib/valgrind/default.supp $(FS_TG_PATH)/lib/valgrind
ifneq ($(strip $(INCLUDE_MIPS)$(INCLUDE_MIPSEL)),)
	cp $(PUBLIC_APPS_PATH)/valgrind-3.18.1/install/lib/valgrind/memcheck-mips32-linux $(FS_TG_PATH)/lib/valgrind
	cp $(PUBLIC_APPS_PATH)/valgrind-3.18.1/install/lib/valgrind/vgpreload_core-mips32-linux.so $(FS_TG_PATH)/lib/valgrind
	cp $(PUBLIC_APPS_PATH)/valgrind-3.18.1/install/lib/valgrind/vgpreload_memcheck-mips32-linux.so $(FS_TG_PATH)/lib/valgrind
endif
ifneq ($(strip $(INCLUDE_ARM)),)
	cp $(PUBLIC_APPS_PATH)/valgrind-3.18.1/install/lib/valgrind/memcheck-arm-linux $(FS_TG_PATH)/lib/valgrind
	cp $(PUBLIC_APPS_PATH)/valgrind-3.18.1/install/lib/valgrind/vgpreload_core-arm-linux.so $(FS_TG_PATH)/lib/valgrind
	cp $(PUBLIC_APPS_PATH)/valgrind-3.18.1/install/lib/valgrind/vgpreload_memcheck-arm-linux.so $(FS_TG_PATH)/lib/valgrind
else
ifneq ($(strip $(INCLUDE_ARM64)),)
	cp $(PUBLIC_APPS_PATH)/valgrind-3.18.1/install/lib/valgrind/memcheck-arm64-linux $(FS_TG_PATH)/lib/valgrind
	cp $(PUBLIC_APPS_PATH)/valgrind-3.18.1/install/lib/valgrind/vgpreload_core-arm64-linux.so $(FS_TG_PATH)/lib/valgrind
	cp $(PUBLIC_APPS_PATH)/valgrind-3.18.1/install/lib/valgrind/vgpreload_memcheck-arm64-linux.so $(FS_TG_PATH)/lib/valgrind
endif
endif
#	cp $(PUBLIC_APPS_PATH)/valgrind-3.18.1/install/lib/valgrind/32bit* $(FS_TG_PATH)/lib/valgrind
#	cp $(PUBLIC_APPS_PATH)/valgrind-3.18.1/install/lib/valgrind/mips-* $(FS_TG_PATH)/lib/valgrind
valgrind_ver:
	echo "valgrind version :3.18.1" >> $(BBA_PRODUCT_VER_FILE)

