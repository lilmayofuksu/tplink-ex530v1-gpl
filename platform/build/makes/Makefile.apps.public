#	cp $(MEDIA_SERVER_INSTALL)/lib/libiconv.so.2.5.1 $(FS_TG_PATH)/lib
	cp $(MEDIA_SERVER_INSTALL)/lib/libswscale.so.3.1.101 $(FS_TG_PATH)/lib
