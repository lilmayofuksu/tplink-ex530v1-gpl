	cp $(MEDIA_SERVER_INSTALL)/lib/libjpeg.so.9.0.0 $(FS_TG_PATH)/lib
	cp $(MEDIA_SERVER_INSTALL)/lib/libid3tag.so.0.3.0 $(FS_TG_PATH)/lib
