ifeq ($(INCLUDE_USB_SYSFS), y)
LIBUSB_CFLAGS = -DINCLUDE_USB_SYSFS -g -O2
else
LIBUSB_CFLAGS = -g -O2
endif
ifeq ($(INCLUDE_ECONET), y)
LIBUSB_CFLAGS += -DINCLUDE_ECONET
endif
ifeq ($(INCLUDE_QUALCOMM), y)
LIBUSB_CFLAGS += -DINCLUDE_QUALCOMM
endif
ifeq ($(INCLUDE_QUECTEL), y)
LIBUSB_CFLAGS += -DINCLUDE_QUECTEL
endif
ifeq ($(INCLUDE_MUSL_LIBC), y)
LIBUSB_CFLAGS += -DINCLUDE_MUSL_LIBC 
endif
libusb:
	echo "Building usb library"
	cd $(PUBLIC_APPS_PATH)/libusb-1.0.8 && test -e Makefile || \
	(export CFLAGS+="$(LIBUSB_CFLAGS) $(ARCH_CFLAGS) -Wall -Werror=implicit-function-declaration"; \
		./configure --build=i686-linux --host=$(HOST) \
		--prefix=$(PUBLIC_APPS_PATH)/libusb-1.0.8/install --disable-timerfd \
	)
	cd $(PUBLIC_APPS_PATH)/libusb-1.0.8 && touch aclocal.m4 && $(MAKE) install
libusb_install:
	cp --no-dereference -p $(PUBLIC_APPS_PATH)/libusb-1.0.8/install/lib/libusb-1.0.so* $(FS_TG_PATH)/lib/
libusb_clean:
	-cd $(PUBLIC_APPS_PATH)/libusb-1.0.8 && test -e Makefile && $(MAKE) clean && rm -f Makefile
	-cd $(PUBLIC_APPS_PATH)/libusb-1.0.8 && rm -rf install/*
libusb_ver:
	echo "libusb version : 1.0.8" >> $(BBA_PRODUCT_VER_FILE)


libcompat:
	echo "Building usb compat"
	cd $(PUBLIC_APPS_PATH)/libusb-compat-0.1.3 && test -e Makefile || \
	(export CFLAGS+="$(LIBUSB_CFLAGS) -Wall -Werror=implicit-function-declaration"; \
		./configure --host=$(HOST) --prefix=$(PUBLIC_APPS_PATH)/libusb-compat-0.1.3/install \
		LIBUSB_1_0_CFLAGS=-I$(PUBLIC_APPS_PATH)/libusb-1.0.8/install/include/libusb-1.0 \
		LIBUSB_1_0_LIBS=-L$(PUBLIC_APPS_PATH)/libusb-1.0.8/install/lib\ -lusb-1.0 \
	)
	cd $(PUBLIC_APPS_PATH)/libusb-compat-0.1.3 && $(MAKE) install
libcompat_install:
	cp --no-dereference -p $(PUBLIC_APPS_PATH)/libusb-compat-0.1.3/install/lib/libusb-0.1.so* $(FS_TG_PATH)/lib/
	cp --no-dereference -p $(PUBLIC_APPS_PATH)/libusb-compat-0.1.3/install/lib/libusb.so $(FS_TG_PATH)/lib/
libcompat_clean:
	-cd $(PUBLIC_APPS_PATH)/libusb-compat-0.1.3 && test -e Makefile && $(MAKE) clean && rm -f Makefile
	-cd $(PUBLIC_APPS_PATH)/libusb-compat-0.1.3 && rm -rf install/*
libcompat_ver:
	echo "libusb-compat version : 0.1.3" >> $(BBA_PRODUCT_VER_FILE)


