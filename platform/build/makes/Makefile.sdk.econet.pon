####################################################
# Supplier compiler variable        
####################################################	
SDK_MAKE_ARGS=

# For toolchain path
ifeq (arm,$(ARCH))
export HOST=arm-linux
ifeq (UNION_EN7523_GLIBC_7915D_MAP_demo, $(SDK_CONFIG))
export CC_TARBALL=buildroot-gcc493_glibc222_arm32_32bServer.tar.gz
export TOOLPREFIX=arm-buildroot-linux-gnueabi-
export TOOLROOTPATH=/opt/trendchip/buildroot-gcc493_glibc222_arm32_32bServer/usr/
export SLIB_PATH=$(SDK_PATH)/Project/lib/arm32-gcc493-glibc222-lib
export AWK=/usr/bin/gawk
CUSTOM=CT
MPLATFORM=UNION_EN7523_GLIBC_7915_7915_ActiveEthWan_demo
SDK_MAKE_ARGS:=$(SDK_MAKE_ARGS) -f $(SDK_PATH)/app_bsp/MakeFile_Main_BSP MPLATFORM=$(MPLATFORM)
else ifeq (UNION_EN7523_GLIBC_7916D_7623_MAP_demo, $(SDK_CONFIG))
export CC_TARBALL=buildroot-gcc493_glibc222_arm32_32bServer.tar.gz
export TOOLPREFIX=arm-buildroot-linux-gnueabi-
export TOOLROOTPATH=/opt/trendchip/buildroot-gcc493_glibc222_arm32_32bServer/usr/
export SLIB_PATH=$(SDK_PATH)/Project/lib/arm32-gcc493-glibc222-lib
export AWK=/usr/bin/gawk
CUSTOM=CT
MPLATFORM=UNION_EN7523_GLIBC_7916D_7623_MAP_demo
SDK_MAKE_ARGS:=$(SDK_MAKE_ARGS) -f $(SDK_PATH)/app_bsp/MakeFile_Main_BSP MPLATFORM=$(MPLATFORM)
else
export CC_TARBALL=mips-linux-uclibc-4.3.6-v2.tgz
export TOOLPREFIX=mips-unknown-linux-uclibc-
export TOOLROOTPATH=/opt/trendchip/mips-linux-uclibc-4.3.6-v2/usr
export SLIB_PATH=$(TOOLROOTPATH)/mips-unknown-linux-uclibc/sysroot
endif
else #(arm,$(ARCH))
$(warning "mips crosscompiler")
export HOST=mipsel-linux
ifeq (UNION_EN7580_SFU_KERNEL_4_4_demo, $(SDK_CONFIG))
export CC_TARBALL=mipsel-linux-glibc2.22-4.6.3.tgz
export TOOLPREFIX=mipsel-buildroot-linux-gnu-
export TOOLROOTPATH=/opt/trendchip/mipsel-linux-glibc2.22-4.6.3/usr/
export SLIB_PATH=$(SDK_PATH)/Project/lib/mips-linux-glibc-v4.6-el
export AWK=/usr/bin/gawk
CUSTOM=CT
MPLATFORM=UNION_EN7580_SFU_KERNEL_4_4_demo
SDK_MAKE_ARGS:=$(SDK_MAKE_ARGS) -f $(SDK_PATH)/app_bsp/MakeFile_Main_BSP MPLATFORM=$(MPLATFORM)
else # (UNION_EN7580_SFU_KERNEL_4_4_demo, $(SDK_CONFIG))
$(warning "TODO: crosscompiler not enhance yet")
endif # (UNION_EN7580_SFU_KERNEL_4_4_demo, $(SDK_CONFIG))
endif #(arm,$(ARCH))

# For SDK Profile
export PROFILE=$(SDK_CONFIG)
export SDK_CONFIG_FILE=$(SDK_PATH)/Project/profile/CT/$(PROFILE)/$(PROFILE).profile
# For Kernl Path
ifeq (UNION_EN7523_GLIBC_7915D_MAP_demo, $(SDK_CONFIG))
export KERNELPATH=$(SDK_PATH)/linux-4.4.115
export KERNELHEADER=$(KERNELPATH)/usr/include
else ifeq (UNION_EN7523_GLIBC_7916D_7623_MAP_demo, $(SDK_CONFIG))
export KERNELPATH=$(SDK_PATH)/linux-4.4.115
export KERNELHEADER=$(KERNELPATH)/usr/include
else ifeq (UNION_EN7580_SFU_KERNEL_4_4_demo, $(SDK_CONFIG))
$(warning "UNION_EN7580_SFU_KERNEL_4_4_demo")
export KERNELPATH=$(SDK_PATH)/linux-4.4.115
export KERNELHEADER=$(KERNELPATH)/usr/include
else
export KERNELPATH=$(SDK_PATH)/linux-2.6.36
# For some special application, such like ipsectool
export KERNELHEADER=$(KERNELPATH)/include
endif

SDK_MAKE_ARGS:=$(SDK_MAKE_ARGS) CUSTOM=$(CUSTOM) MSDK=1 PROFILE=$(PROFILE)

###############################################################################

# For cross compiler
export CC = $(TOOLPREFIX)gcc
export LD = $(TOOLPREFIX)ld
export AR = $(TOOLPREFIX)ar
export STRIP = $(TOOLPREFIX)strip
export RANLIB = $(TOOLPREFIX)ranlib
export MAKEARCH = $(MAKE) ARCH=$(ARCH)
export PATH:=$(TOOLROOTPATH)/bin:$(PATH)
export LD_LIBRARY_PATH:=$(TOOLROOTPATH)/lib:$(LD_LIBRARY_PATH)

export KERNELARCH=$(ARCH)
export KERNELRELEASE=$(shell cat $(KERNELPATH)/include/config/kernel.release 2> /dev/null)
export KERNELVERSION=$(shell cat $(KERNELPATH)/include/linux/version.h 2> /dev/null | grep -o [0-9]\\\{1,\\\}$$)

###############################################################################

SUPPILER_INCLUDE  =

SUPPILER_LD  =

SUPPLIER_FLAGS  =

MODEL_LED_CONF = $(MODEL_PATH)/led_def.conf
ifeq (UNION_EN7580_SFU_KERNEL_4_4_demo, $(SDK_CONFIG))
BOOT_LED_CONF = $(BOOTROM_DIR)/bootram/init/tp_led_gpio_def.h
else
BOOT_LED_CONF = $(UBOOT_DIR)/$(TCSUPPORT_UBOOT_VERSION)/include/tp_led_gpio_def.h
$(warning "BOOT_LED_CONF" $(BOOT_LED_CONF))
endif # UNION_EN7580_SFU_KERNEL_4_4_demo

# Remove "_demo" to get chip number
ifeq ($(SDK_CONFIG), UNION_EN7523_GLIBC_7915D_MAP_demo)
export CPU_TYPE=en7523
else ifeq ($(SDK_CONFIG), UNION_EN7523_GLIBC_7916D_7623_MAP_demo)
export CPU_TYPE=en7523
else ifeq ($(SDK_CONFIG), UNION_EN7580_SFU_KERNEL_4_4_demo)
export CPU_TYPE=en7580
else
export CPU_TYPE=$(subst _demo,,$(SDK_CONFIG))
endif
SUPPLIER_FLAGS += -DTCSUPPORT_CPU_$(shell echo $(CPU_TYPE) | tr '[a-z]' '[A-Z]')


# For SDK specific include, for apps/
export SUPPILER_INCLUDE
# For SDK specific library, for apps/
ifneq ($(SDK_CONFIG), UNION_EN7580_SFU_KERNEL_4_4_demo)
SUPPILER_LD += -L$(BSP_EXT_FS)/lib -liw
endif # UNION_EN7580_SFU_KERNEL_4_4_demo
export SUPPILER_LD
# For SDK specific flag
export SUPPLIER_FLAGS

###############################################################################

# For pure SDK used

export CROSS_COMPILE=$(TOOLPREFIX)
export SDK_PATH

SDK_PATH2=$(subst /,\/,$(SDK_PATH))
$(shell sed -i 's/TRUNK_DIR=.*/TRUNK_DIR=$(SDK_PATH2)/g' $(SDK_PATH)/Project/dir.mak)
$(shell sed -i 's/^export BSP_CFLAGS.*/export BSP_CFLAGS += $$(SDK_FLAGS)/g' $(SDK_PATH)/Project/rule.mak)
$(shell sed -i 's/^export TC_CFLAGS.*/export TC_CFLAGS += $$(SDK_FLAGS)/g' $(SDK_PATH)/apps/private/apps_rule.mak)
$(shell sed -i 's/TRUNK_DIR=.*/TRUNK_DIR=$(SDK_PATH2)/g' $(SDK_PATH)/apps/private/apps_dir.mak)


-include $(SDK_PATH)/Project/rule.mak
-include $(SDK_PATH)/Project/dir.mak
#-include $(SDK_PATH)/apps/private/apps_rule.mak
#-include $(SDK_PATH)/apps/private/apps_dir.mak


###############################################################################
# SDK build label
###############################################################################
sdk/%::
	cd $(SDK_PATH) && $(MAKE) $(SDK_MAKE_ARGS) $(patsubst sdk/%, %, $@)

sdkapp/%::
	cd $(SDK_PATH) && $(MAKE) -f $(SDK_PATH)/apps/private/MakeFile_Main_APP MPLATFORM=$(MPLATFORM) CUSTOM=$(CUSTOM) MSDK=1 PROFILE=$(PROFILE) $(patsubst sdkapp/%, %, $@)

sdk_test:
	cd /mine/test && $(CC) -o zero zero.c

supplier_env_build:
ifeq ($(TCSUPPORT_3_18_21_KERNEL),)
#	cp -f $(SDK_PATH)/tools/atm.h $(TOOLROOTPATH)/mips-unknown-linux-uclibc/sysroot/usr/include/linux/atm.h
endif
	echo $(TOOLROOTPATH)
	if [ ! -e $(TOOLROOTPATH) ]; then \
		echo "Install toolchain..."; \
		tar -xvf $(SDK_PATH)/$(CC_TARBALL) -C /; \
	fi
	cd $(SDK_PATH) && $(MAKE) $(SDK_MAKE_ARGS) bsp_prepare
	cat $(MODEL_PATH)/config.sdk | sed -r -e 's/#/\/\//g' -e 's/^([^=]*)=(.*)$$/#define \1=\2/g' -e 's/=y$$/=1/g' > $(MODEL_PATH)/config.sdk.h

supplier_tools:
	cd $(SDK_PATH) && $(MAKE) $(SDK_MAKE_ARGS) tools
	
supplier_tools_clean:

###############################################################################
.PHONY: supplier_menuconfig
supplier_menuconfig:
	cp -pfT $(MODEL_PATH)/config.sdk $(SDK_CONFIG_FILE)
	cd $(SDK_PATH) && $(MAKE) $(SDK_MAKE_ARGS) menuconfig
	cp -pfT $(SDK_CONFIG_FILE) $(MODEL_PATH)/config.sdk
	cat $(MODEL_PATH)/config.sdk | sed -r -e 's/#/\/\//g' -e 's/^([^=]*)=(.*)$$/#define \1=\2/g' -e 's/=y$$/=1/g' > $(MODEL_PATH)/config.sdk.h

###############################################################################	
supplier_boot_build: gen_$(BOOT_LED_CONF)
	@echo "Make Boot Build"
	cp -pfT $(MODEL_PATH)/mi.conf $(PROFILE_DIR)/mi.conf
	cd $(SDK_PATH) && $(MAKE) $(SDK_MAKE_ARGS) bootbase_clean
	cd $(SDK_PATH) && $(MAKE) $(SDK_MAKE_ARGS) bootbase
	cp $(IMAGE_DIR)/tcboot.bin $(BOOT_TG_PATH)/boot.bin
	cp $(IMAGE_DIR)/bootext.ram $(BOOT_TG_PATH)/bootext.ram
ifneq ($(SDK_CONFIG), UNION_EN7580_SFU_KERNEL_4_4_demo)
	cp $(TOOLS_UBOOT_DIR)/mkimage $(KERNEL_TG_PATH)
endif # UNION_EN7580_SFU_KERNEL_4_4_demo
	
supplier_boot_clean:
	cd $(SDK_PATH) && $(MAKE) $(SDK_MAKE_ARGS) bootbase_clean

gen_$(BOOT_LED_CONF):
	@echo "Generating $(BOOT_LED_CONF)"
	@echo -ne 'typedef struct _TP_BOOT_LED_DEF\n{\n\tunsigned int id;\n\tunsigned char gpio;\n\tunsigned char reverse;\n} TP_BOOT_LED_DEF;\n' > $(BOOT_LED_CONF)
	@echo -ne '\n#define CHAR2ID(a,b,c,d) (((a) << 24) | ((b) << 16) | ((c) << 8) | (d))\n' >> $(BOOT_LED_CONF)
	@echo -ne 'static struct _TP_BOOT_LED_DEF tp_boot_led_def[] = \n{\n' >> $(BOOT_LED_CONF)
	@grep -v "^#" $(MODEL_LED_CONF) | grep -v "^loops_per_sec=" | sed 's/\r//g' | grep -v "^$$" | awk '{x=length($$1);y=4-x;printf "\t{CHAR2ID(";for(i=1;i<=x;i++) printf "'\''"substr($$1,i,1)"'\''"; for(i=1;i<=y;i++) printf "'\'\''"; printf "), "$$2", "$$5"},\n"}' | sed -e "s/''/','/g" -e "s/''/0/g" >> $(BOOT_LED_CONF)
	@echo -ne '};\n' >> $(BOOT_LED_CONF)
	
###############################################################################
supplier_kernel_menuconfig:
	cp -pfT $(MODEL_PATH)/config.kernel $(PROFILE_DIR)/$(KERNEL_CONF)
	cd $(SDK_PATH) && $(MAKE) $(SDK_MAKE_ARGS) kernel_menuconfig
	cp -pfT $(PROFILE_DIR)/$(KERNEL_CONF) $(MODEL_PATH)/config.kernel

supplier_kernel_build:
	@echo "ARCH = "$(ARCH)
	cp -pfT $(MODEL_PATH)/config.kernel $(PROFILE_DIR)/$(KERNEL_CONF)
	cd $(SDK_PATH) && $(MAKE) $(SDK_MAKE_ARGS) kernel
ifeq (UNION_EN7580_SFU_KERNEL_4_4_demo, $(SDK_CONFIG))
	cp -pf $(KERNELPATH)/linux.7z $(KERNEL_TG_PATH)/linux.7z
	cp -pf $(KERNELPATH)/vmlinux $(KERNEL_TG_PATH)	
else #(UNION_EN7580_SFU_KERNEL_4_4_demo, $(SDK_CONFIG))
	cp -pf $(KERNELPATH)/linux.7z $(KERNEL_TG_PATH)/linux.7z.origin
	cp -pf $(KERNELPATH)/vmlinux $(KERNEL_TG_PATH)
	cp -pf $(MODEL_PATH)/uImage.its $(KERNEL_TG_PATH)
	cp -af $(KERNEL_DIR)/arch/arm/boot/dts/en7523.dtb $(KERNEL_TG_PATH)/ecnt.dtb
	cd $(KERNEL_TG_PATH) && ./mkimage -f uImage.its linux.7z
endif #(UNION_EN7580_SFU_KERNEL_4_4_demo, $(SDK_CONFIG))

supplier_kernel_clean:
	cd $(SDK_PATH) && $(MAKE) $(SDK_MAKE_ARGS) kernel_clean

###############################################################################

supplier_modules_build:
	@echo "Making supplier modules"
	cd $(SDK_PATH) && $(MAKE) $(SDK_MAKE_ARGS) modules

supplier_modules_install:
	cp -pfR $(BSP_EXT_FS)/lib/modules/$(KERNELRELEASE)/kernel $(FS_TG_PATH)/lib/modules/kmdir/
	cp -pf $(BSP_EXT_FS)/lib/modules/*.ko $(FS_TG_PATH)/lib/modules/

supplier_modules_clean:
	cd $(SDK_PATH) && $(MAKE) $(SDK_MAKE_ARGS) modules_clean

