###############################################################################

# For specific SDK device node
CONFIG_DEVTMPFS_MOUNT=$(shell grep -E CONFIG_DEVTMPFS_MOUNT $(MODEL_PATH)/config.kernel)
supplier_fs_dev: fakeroot
	@echo "Start supplier_fs_dev, CONFIG_DEVTMPFS_MOUNT is $(CONFIG_DEVTMPFS_MOUNT)"
ifneq ($(CONFIG_DEVTMPFS_MOUNT),)	##do dev create in rcS
	@echo "Copy build devs to rootfs, should run in rcS procedure"
	cp $(MODEL_PATH)/buildDevs $(FS_TG_PATH)/etc/
	chmod +x $(FS_TG_PATH)/etc/buildDevs
else
	@echo "Create devs node file by buildDevs"
	-test -e $(MODEL_PATH)/buildDevs \
		&& $(TOOLS_PATH)/fakeroot/fakeroot \
		-i $(TOOLS_PATH)/fakeroot/.fake_env/$(MODEL).fake \
		-s $(TOOLS_PATH)/fakeroot/.fake_env/$(MODEL).fake \
		$(MODEL_PATH)/buildDevs $(FS_TG_PATH)
endif
	@echo "Done"

###############################################################################
dummy_debug_build:
# back up config file and gif file
	@echo "prepare dummy debug image"
	cp $(MODEL_PATH)/reduced_data_model.xml $(MODEL_PATH)/reduced_data_model.xml.dummy;
	cp $(MODEL_PATH)/config.bba $(MODEL_PATH)/config.bba.dummy;
	cp $(MODEL_PATH)/../../../makes/shell/dummy.sh $(MODEL_PATH)/dummy.sh;
	cp -pR $(BBA_PATH)/web/en/common_mark_img/mark_white.gif $(BBA_PATH)/web/en/common_mark_img/mark_white.gif.bak
	cp -pR $(BBA_PATH)/web/en/common_mark_img/mark_beta.gif $(BBA_PATH)/web/en/common_mark_img/mark_white.gif
	mkdir -p $(BBA_PATH)/targets/$(MODEL)/$(SPEC)/imageBak
	mv $(BBA_PATH)/targets/$(MODEL)/$(SPEC)/image/* $(BBA_PATH)/targets/$(MODEL)/$(SPEC)/imageBak/

# rebuild dummy-beta image
	@echo "start dummy.sh"
	chmod 777 $(MODEL_PATH)/dummy.sh;
	cd $(MODEL_PATH); \
	./dummy.sh reduced_data_model.xml;

	@echo "start make dummy image"
	make MODEL=$(MODEL) -C $(MAKES_PATH)/../ BETA=y cmm -B
	$(MAKE) BETA=y fs_build
	$(MAKE) BETA=y image_build

	mkdir -p $(BBA_PATH)/targets/$(MODEL)/$(SPEC)/dummyImage
	mv $(BBA_PATH)/targets/$(MODEL)/$(SPEC)/image/*0.64.0*.bin $(BBA_PATH)/targets/$(MODEL)/$(SPEC)/dummyImage

# Restore modified files
	@echo "finish make dummy image"
	cp $(MODEL_PATH)/reduced_data_model.xml.dummy $(MODEL_PATH)/reduced_data_model.xml;
	cp $(MODEL_PATH)/config.bba.dummy $(MODEL_PATH)/config.bba;
	cp -pR $(BBA_PATH)/web/en/common_mark_img/mark_white.gif.bak $(BBA_PATH)/web/en/common_mark_img/mark_white.gif
	mv $(BBA_PATH)/targets/$(MODEL)/$(SPEC)/imageBak/* $(BBA_PATH)/targets/$(MODEL)/$(SPEC)/image/
	mv $(BBA_PATH)/targets/$(MODEL)/$(SPEC)/dummyImage/* $(BBA_PATH)/targets/$(MODEL)/$(SPEC)/image/
	rm $(MODEL_PATH)/dummy.sh $(BBA_PATH)/web/en/common_mark_img/mark_white.gif.bak  $(MODEL_PATH)/config.bba.dummy $(MODEL_PATH)/reduced_data_model.xml.dummy
	rm -rf $(BBA_PATH)/targets/$(MODEL)/$(SPEC)/imageBak $(BBA_PATH)/targets/$(MODEL)/$(SPEC)/dummyImage

