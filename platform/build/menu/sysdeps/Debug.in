

menu 'DEBUG Options'
config INCLUDE_CMM_OPTIMIZE_SIZE
	bool "build private/user apps with -Os"
	default n

choice
	prompt "CMM Debug Level"
	default INCLUDE_CDBG_LEVEL1
	help
	  Choose CMM Debug Level

config INCLUDE_CDBG_LEVEL1
	bool "CDBG_LEVEL1: only print ERROR msg"

config INCLUDE_CDBG_LEVEL2
	bool "CDBG_LEVEL2: print ERROR & NOTICE msg"
	
config INCLUDE_CDBG_LEVEL3
	bool "CDBG_LEVEL3: print all msg"

config INCLUDE_CDBG_RUNTIME
	bool "CDBG_RUNTIME: modify debug level runtime. Notice: only enabled in debug version"

endchoice

config INCLUDE_CORE_DUMP_SIZE
	string "Set core dump size(number: blocks(0.5KB); 0: disabled; unlimited: unlimited)"
	default "512"

config INCLUDE_CORE_DUMP_MAPS
	bool "Store /proc/pid/maps to /var when coredump"
	default n

config INCLUDE_CDBG_DUMPSTACK
	bool "Use tdb to dump stack in CDBG_DUMPSTACK"
	default n

choice
	prompt "CMM Symbol Strip Level"
	default INCLUDE_CMM_STRIP_ALL
	help
		Choose CMM Strip Symbol Level

config INCLUDE_CMM_STRIP_ALL
	bool "Strip all unneeded symbols(default)"

config INCLUDE_CMM_STRIP_DEBUG
	bool "Strip only debug symbols(for tdb)"

config INCLUDE_CMM_STRIP_NONE
	bool "Do not strip any symbol(for gdb/valgrind)"
	help
		Works better with INCLUDE_CMM_OPTIMIZE_SIZE(build private/user apps with -Os) disabled.

endchoice

config INCLUDE_KEEP_LIB_SYMBOL
	bool "Do not strip symbol of SDK libs(mainly for gdb/valgrind)"
	default n

config INCLUDE_BCM_DSLDIAGD
	bool "for bcm dsldiagd "
	default n

config INCLUDE_HTTP_JSON_FMT
	bool "httpd return json with readable format"
	default n

config INCLUDE_TCPDUMP
	bool "build tcpdump tools"
	default n

config INCLUDE_STRACE
	bool "build strace tools"
	default n

config INCLUDE_VALGRIND
	bool "build valgrind tools"
	default n

config INCLUDE_MEM_DBG_SCRIPT
	bool "add memory debug shell script to image"
	default n

config INCLUDE_PRLIMIT
	bool "build prlimit tool"
	default n

config INCLUDE_TEST
	bool "test config by yangxv(mainly not used)"
	default n
	
config INCLUDE_DEBUG_LOCK
	bool "get lock and unlock info from /var/run/debug_dmlock.txt or debug_lock_*.txt"
	default n

config INCLUDE_MSG_DEBUG
	bool "get msg send info from /var/run/debug_msg.txt"
	default n

config INCLUDE_DEBUG_DETAIL_FORCED
	bool "force to print debug detail"
	default n

config INCLUDE_DEBUG_CUTIL_CC_LEVEL
	int "cutil compile debug level (0:error, 1:warning, 2:debug, 3:trace)"
	range 0,3
	default 1

config INCLUDE_DEBUG_CUTIL_RUN_LEVEL
	int "cutil running debug level (0:error, 1:warning, 2:debug, 3:trace)"
	range 0,3
	default 1

config INCLUDE_DEBUG_SMHM_INF_CC_LEVEL
	int "smarthome interface compile debug level (0:error, 1:warning, 2:debug, 3:trace)"
	range 0,3
	default 1

config INCLUDE_DEBUG_SMHM_INF_RUN_LEVEL
	int "smarthome interface running debug level (0:error, 1:warning, 2:debug, 3:trace)"
	range 0,3
	default 1

config INCLUDE_DEBUG_GDPR_CC_LEVEL
