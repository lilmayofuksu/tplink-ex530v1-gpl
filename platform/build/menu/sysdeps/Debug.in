	bool "Print rdp/rsl call trace"
	default n

config INCLUDE_DEBUG_WEB_DATAMSG
	bool "Enable WEB debug($.debug=true to print AJAX msg)"
	default n
	help
		If enabled, input '$.debug=true' in WEB browser console to print all AJAX msgs.
		Input '$.debug=false' to stop print AJAX msgs.

config INCLUDE_DEBUG_WEB_TRANS
	bool "Do WEB translate selftest when loading page and print errs to WEB console"
	default n
	help
		If enabled, translate code erros will print to WEB browser console when loading new page.
		Input '$.debugT=false' in WEB console to stop printing.
		You can also input '$.debugT=true' to start this check even if this option is not selected.

config INCLUDE_DEBUG_FWLOGD_CC_LEVEL
