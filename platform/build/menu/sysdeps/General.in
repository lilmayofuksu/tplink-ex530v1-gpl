menu "Suppiler Setting"

choice
	prompt "Chipset Suppiler"
	default INCLUDE_BROADCOM
	help
	  Choose Main Chipset Suppiler

config INCLUDE_BROADCOM
	bool "Broadom SDK 4.xL.x"

config INCLUDE_BCM_CHIP_BCM68360
	bool "Broadcom Chipset BCM68360"
	depends on INCLUDE_BROADCOM
	default n

config INCLUDE_BCM_CHIP_BCM63146
	bool "Broadcom Chipset BCM63146"
	depends on INCLUDE_BROADCOM
	default n

config INCLUDE_QUALCOMM
	bool "Qualcomm SDK SPF"

config INCLUDE_QCA_MEM_256
	bool "Segment For QCA 256M DDR"
	default n
	depends on INCLUDE_QUALCOMM
	help
		Build 256M QCA DDR image.

config INCLUDE_QCA_12_1
	bool "Segment For QCA SDK 12.1"
	default n
	depends on INCLUDE_QUALCOMM
	help
		Build For QCA SDK 12.1

config INCLUDE_ECONET
	bool "Econet SDK 7.x"

config INCLUDE_MTK
	bool "MTK SDK LEDE-4.2"
	
config INCLUDE_QUECTEL
	bool "Quectel T750 SDK"

config INCLUDE_REALTEK
	bool "Realtek SDK"

endchoice
config INCLUDE_MTK_CHIP_MT7986
	bool "MTK Chipset MT7986"
	depends on INCLUDE_MTK
	default n
	help
		MT7986 SoC

config INCLUDE_ECONET_MT7513
	bool "ECONET Chipset MT7513"
	depends on INCLUDE_ECONET
	default n
	help 
		MT7513 SoC, for tp_gpio modules

config SDK_REPO_URL
	string "Supplier SDK URL"
	default "https://spcodes.rd.tp-link.net/common/Broadcom_4_16L_05.git" if INCLUDE_BROADCOM
	default "https://spcodes.rd.tp-link.net/common/Qualcomm_SPF_5_0.git" if INCLUDE_QUALCOMM
	default "https://spcodes.rd.tp-link.net/common/Econet_7_3_207_4.git" if INCLUDE_ECONET
	default "https://spcodes.rd.tp-link.net/common/mt7621_sdk.git" if INCLUDE_MTK

config SDK_DIR
	string "SDK directory"
	default "unknown"

config SUPPLIER
	string "Chipset Suppiler for Makefile.sdk.*"
	default "broadcom" if INCLUDE_BROADCOM
	default "qualcomm" if INCLUDE_QUALCOMM
	default "econet" if INCLUDE_ECONET
	default "quectel" if INCLUDE_QUECTEL
	default "realtek" if INCLUDE_REALTEK

config SDK_CONFIG
	string "SDK Config, such as PROFILE, PLATFORM.."
	default "963268GWV" if INCLUDE_BROADCOM
	default "en7512_demo" if INCLUDE_ECONET

endmenu

menu "CPU Architeture Setting"

choice
	prompt "Userspace CPU Architeture Type"
	help
	  Choose Usersapce CPU Architeture Type

config INCLUDE_MIPS
	bool "MIPS"

config INCLUDE_MIPSEL
	bool "MIPSEL"

config INCLUDE_ARM
	bool "ARM"

config INCLUDE_ARM64
	bool "ARM64"

endchoice

config INCLUDE_ARCH
	string
	default "mips" if INCLUDE_MIPS
	default "mipsel" if INCLUDE_MIPSEL
	default "arm" if INCLUDE_ARM
	default "arm64" if INCLUDE_ARM64

choice
	prompt "Kernel CPU Architeture Type"
	help
	  Choose Kernel CPU Architeture Type

config INCLUDE_KERNEL_MIPS
	bool "MIPS"

config INCLUDE_KERNEL_MIPSEL
	bool "MIPSEL"

config INCLUDE_KERNEL_ARM
	bool "ARM"

config INCLUDE_KERNEL_ARM64
	bool "ARM64"

endchoice

config INCLUDE_KARCH
	string
	default "mips" if INCLUDE_KERNEL_MIPS
	default "mipsel" if INCLUDE_KERNEL_MIPSEL
	default "arm" if INCLUDE_KERNEL_ARM
	default "arm64" if INCLUDE_KERNEL_ARM64

choice
	prompt "Endian Type"
	default INCLUDE_BIG_ENDIAN
	help
	  Choose CPU Endian Type

config INCLUDE_BIG_ENDIAN
	bool "Big endian"

config INCLUDE_LITTLE_ENDIAN
	bool "Little endian"

endchoice

config INCLUDE_ENDIAN_FLAG_IMAGE
	int
	default 0 if INCLUDE_BIG_ENDIAN
	default 1 if INCLUDE_LITTLE_ENDIAN

config INCLUDE_ENDIAN_FLAG_ROOTFS
	string
	default "-b"  if  INCLUDE_MTD_TYPE_FS && INCLUDE_BIG_ENDIAN
	default "-l"  if  INCLUDE_MTD_TYPE_FS && INCLUDE_LITTLE_ENDIAN
	default "-be" if !INCLUDE_MTD_TYPE_FS && INCLUDE_BIG_ENDIAN
	default "-le" if !INCLUDE_MTD_TYPE_FS && INCLUDE_LITTLE_ENDIAN

endmenu

choice
	prompt "Compress Type"
	default INCLUDE_COMPRESS_XZ
	help
	  Choose CPU Endian Type

config INCLUDE_COMPRESS_LZMA
	bool "LZMA"

config INCLUDE_COMPRESS_XZ
	bool "XZ"
endchoice

config INCLUDE_COMPRESS_TYPE
	string
	default "lzma" if INCLUDE_COMPRESS_LZMA
	default "xz"  if INCLUDE_COMPRESS_XZ

config INCLUDE_LINUX_DTS_SUPPORT
	bool "Linux DTS support: only for patch-dtb"
	default n

config INCLUDE_LINUX_DTS_NAME
	string "DTS filename"
	depends on INCLUDE_LINUX_DTS_SUPPORT

menu "Flash Setting"

choice
	prompt "Flash Type"
	default INCLUDE_FLASH_SPINOR
	help
	  Choose Flash Type

config INCLUDE_FLASH_SPINOR
	bool "NOR Flash with SPI interface"

config INCLUDE_FLASH_NAND
	bool "NAND Flash with direct access"
	
config INCLUDE_FLASH_SPINAND
	bool "NAND Flash with SPI interface"

endchoice

config INCLUDE_DUAL_IMAGE
	bool "Dual Image support"
	default n

config INCLUDE_DUAL_CONFIG
	bool "Dual Config support"
	default n

choice
	prompt "MTD partition type"
	default INCLUDE_MTD_TYPE_RAW2
	help
	  Choose whether kernel in filesystem

config INCLUDE_MTD_TYPE_RAW1
	bool "RAW1: MTD with RAW data, Misc at tail"

config INCLUDE_MTD_TYPE_RAW2
	bool "RAW2: MTD with RAW data, Misc after Boot"

config INCLUDE_MTD_TYPE_FS
	bool "FS: MTD with filesystem"

endchoice

config INCLUDE_UBI_SYSTEM
	bool "UBI System Support - Sync with ubinize.cfg"
	depends on INCLUDE_MTD_TYPE_FS

config INCLUDE_UBI_DEVNODE
	string "UBI DevNode"
	default "/dev/ubi0"
	depends on INCLUDE_UBI_SYSTEM

config INCLUDE_UBI_KERNEL_VOL_ID
	string "Kernel Volume ID"
	default "0"
	depends on INCLUDE_UBI_SYSTEM
config INCLUDE_UBI_KERNEL_VOL_SIZE
	string "Kernel Volume Size(MiB)"
	default "4"
	depends on INCLUDE_UBI_SYSTEM
config INCLUDE_UBI_KERNEL_VOL_NAME
	string "Kernel Volume Name"
	default "kernelA"
	depends on INCLUDE_UBI_SYSTEM

config INCLUDE_UBI_ROOTFS_VOL_ID
	string "RootFS Volume ID"
	default "1"
	depends on INCLUDE_UBI_SYSTEM
config INCLUDE_UBI_ROOTFS_VOL_SIZE
	string "RootFS Volume Size(MiB)"
	default "50"
	depends on INCLUDE_UBI_SYSTEM
config INCLUDE_UBI_ROOTFS_VOL_NAME
	string "RootFS Volume Name"
	default "rootfsA"
	depends on INCLUDE_UBI_SYSTEM

config INCLUDE_UBI_KERNEL2_VOL_ID
	string "Kernel2 Volume ID"
	default "3"
	depends on INCLUDE_UBI_SYSTEM && INCLUDE_DUAL_IMAGE
config INCLUDE_UBI_KERNEL2_VOL_NAME
	string "Kernel2 Volume Name"
	default "kernelB"
	depends on INCLUDE_UBI_SYSTEM

config INCLUDE_UBI_ROOTFS2_VOL_ID
	string "RootFS2 Volume ID"
	default "4"
	depends on INCLUDE_UBI_SYSTEM && INCLUDE_DUAL_IMAGE
config INCLUDE_UBI_ROOTFS2_VOL_NAME
	string "RootFS2 Volume Name"
	default "rootfsB"
	depends on INCLUDE_UBI_SYSTEM

config INCLUDE_UBI_ROOTFS_TYPE_SQUASH
	bool "Using SquashFS for rootfs image"
	default n
	depends on INCLUDE_UBI_SYSTEM

choice
	prompt "Hardware Flash size, just record only"
	default INCLUDE_FLASH_16M
	help
	  Choose Flash size

config INCLUDE_FLASH_8M
	bool "8M"

config INCLUDE_FLASH_16M
	bool "16M"

config INCLUDE_FLASH_32M
	bool "32M"

config INCLUDE_FLASH_64M
	bool "64M"

config INCLUDE_FLASH_128M
	bool "128M"

config INCLUDE_FLASH_256M
	bool "256M"

config INCLUDE_FLASH_512M
	bool "512M"

config INCLUDE_FLASH_1024M
	bool "1024M"

endchoice

#  64k 0x   10000
# 128k 0x   20000
# 256k 0x   40000
# 512k 0x   80000
#   1M 0x  100000
#   2M 0x  200000
#   4M 0x  400000
#   8M 0x  800000
#  16M 0x 1000000
#  32M 0x 2000000
#  48M 0x 3000000
#  64M 0x 4000000
# 128M 0x 8000000
# 256M 0x10000000
# 512M 0x20000000
#1024M 0x40000000

config INCLUDE_FLASH_BIN_SIZE
		string "Size of image for flash writer(boot + kernel + rootfs and misc)"
		default "0x2000000"

config INCLUDE_LTE_IMAGE_SIZE
		string "LTE image size limit"
		depends on INCLUDE_SINGLE_LTEIMAGE
		default n

config MTD_IMAGE_SIZE
		string "MTD Image partition Size, for oal_partition.h to calculate"
		# 16M
		default "0x1000000" if INCLUDE_FLASH_SPINOR
		# 48M
		default "0x3000000" if !INCLUDE_FLASH_SPINOR

config MTD_BOOT_SIZE 
		string "MTD Boot partition size"
		# 128k
		default "0x20000" if INCLUDE_FLASH_SPINOR
		# 512k
		default "0x80000" if !INCLUDE_FLASH_SPINOR

config MTD_KERNEL_SIZE 
		string "MTD Kernel partition size"
		# 2M
		default "0x200000"
		
config MTD_MISC_SIZE 
		string "MTD Misc partition size(Romfile, Config)"
		# 512k
		default  "0x80000" if INCLUDE_FLASH_SPINOR
		# 1M
		default "0x100000" if !INCLUDE_FLASH_SPINOR

config MTD_BLOCK_SIZE
		string "MTD block size"
		#  64K
		default "0x10000" if INCLUDE_FLASH_SPINOR
		# 128K
		default "0x20000" if !INCLUDE_FLASH_SPINOR

config INCLUDE_RUNTIME_DATA_SECTION
		bool "add runtime_data section"
		default n
		depends on INCLUDE_MTD_TYPE_RAW2 || INCLUDE_MTD_TYPE_RAW1
		help
			runtime_data section saves runtime data, such as parental_ctrl v2 history, reboot info;
			runtime_data section is after Image1 or Image2 section.

config RUNTIME_DATA_SECTION_SIZE
		string "runtime_data section size"
		# 1M
		default "0x100000" if INCLUDE_RUNTIME_DATA_SECTION
		# 0K
		default "0x0" if !INCLUDE_RUNTIME_DATA_SECTION

config INCLUDE_SPEC_SQUASH_BLOCK_SIZE
		bool "Special Squash filesystems compressed block size"
		default n
		depends on INCLUDE_MTD_TYPE_RAW2 || INCLUDE_MTD_TYPE_RAW1 

config INCLUDE_SQUASH_BLOCK_SIZE
		string "Squash compress block size"
		default "0x40000" if INCLUDE_FLASH_SPINOR
		default "0x20000" if !INCLUDE_FLASH_SPINOR
		depends on INCLUDE_SPEC_SQUASH_BLOCK_SIZE

config INCLUDE_IMPORTANT_CONFIG
	bool "Enable extra config block that will not cleared by factory restore"
	default n

endmenu
	
menu 'Firmware Upgrade'

menu 'Firmware Check'
config INCLUDE_FWUPGRADE_CHECK
	bool "Check firmware when upgrade in GUI"
	default n

config INCLUDE_FWUPGRADE_CHECK_MD5
	bool "Check firmware MD5 key"
	depends on INCLUDE_FWUPGRADE_CHECK
	default n

config INCLUDE_FWUPGRADE_CHECK_MD5_KERNEL_KEY
	bool "Support kernel key"
	depends on INCLUDE_FWUPGRADE_CHECK_MD5
	default n

config INCLUDE_FWUPGRADE_CHECK_RSA
	bool "Check firmware RSA key"
	depends on INCLUDE_FWUPGRADE_CHECK
	default n

config INCLUDE_FWUPGRADE_CHECK_PRODUCT_ID
	bool "Check firmware Product ID"
	depends on INCLUDE_FWUPGRADE_CHECK
	default n

config INCLUDE_FWUPGRADE_CHECK_ADDHWVER
	bool "Check firmware Additional Hardware Version"
	depends on INCLUDE_FWUPGRADE_CHECK
	default n
	
config INCLUDE_FWUPGRADE_CHECK_SPECIAL_VER
	bool "Check firmware special Version"
	depends on INCLUDE_FWUPGRADE_CHECK
	default y

config INCLUDE_FWUPGRADE_CHECK_SWVER
	bool "Check firmware SoftwareRevision for Downgrade"
	depends on INCLUDE_FWUPGRADE_CHECK
	default n

config INCLUDE_FWUPGRADE_CHECK_OEM_ID
	bool "Check firmware OEM ID"
	depends on INCLUDE_FWUPGRADE_CHECK
	default n
endmenu

config INCLUDE_FWUPGRADE_BOOT_UPDATE
	bool "Support to upgrade bootloader"
	default n
	
config INCLUDE_RECORD_UPGRADE_INFO
	bool "Record upgrade info, like upgrade status and upgrade time"
	default n

config INCLUDE_ENCRYPT_ROOTFS
	bool "Encrypt the upgrade firmware file's rootfs and decrypt rootfs part before write into flash."
	default n
endmenu

choice
	prompt "Product Region"
	default INCLUDE_REGION_US
	help
	  Choose region type

config INCLUDE_REGION_US
	bool "Product Region (US)"

config INCLUDE_REGION_EU
	bool "Product Region (EU)"
	
config INCLUDE_REGION_AU
	bool "Product Region (AU)"

endchoice
		

config INCLUDE_DIGITAL_SIGNATURE
	bool "Digital signature"
	default n
	
config INCLUDE_MIC
	bool "Build MIC Support"
	default n
	
config INCLUDE_SOCKET_LOCK
	bool "Use socket mechanism for the data model lock"
	default n
	help
		semop can not lock the data model well in some platform

config INCLUDE_CLI_FULL_FEATURE 
	bool "Include all cli cmd"
	default n
	
config INCLUDE_CLI_CMD_SH
	bool "Include cli sh cmd"
	depends on INCLUDE_CLI_FULL_FEATURE
	default n

config INCLUDE_CLI_CMD_DUMP_OID
	bool "Include cli dump oid cmd. Notice: only enabled in debug version"
	depends on INCLUDE_CLI_FULL_FEATURE
	default n

config INCLUDE_CLI_ENC_CMD_DEBUG
	bool "run encrypt cmd without auth. Notice: only enabled in debug version"
	depends on INCLUDE_CLI_FULL_FEATURE
	default n

config INCLUDE_USER_ACCOUNT
	bool "Enable user account,default no need set"
	default n

config INCLUDE_USER_DEFAULT_PWD_WARN
	bool "remind user to change default pwd when login with default username and pwd"
	depends on INCLUDE_USER_ACCOUNT
	default n

config INCLUDE_CHGINIT_PWD
	bool "Enable change password when init"
	default n

config INCLUDE_CHGINIT_PWD_CN
	bool "Enable change password for domestic market"
	depends on INCLUDE_CHGINIT_PWD
	default n

config INCLUDE_DHCP_OPTION133
        bool "Support DHCPC option 133(Send to WAN side). This option assigns the priority within an Ethernet frame header when using VLAN tag, it specifies a priority value between 0 and 7 to differentiate the traffic priority"
        default n

config INCLUDE_DHCP_OPTION60
	bool "Enalbe DHCP Option 60 for ISP Config"
	default n

config INCLUDE_OPTION66
	bool "Enable DHCP Option 66 for ISP Config"
	default n

config INCLUDE_OPTION66_NEED_TAG
	bool "Enable DHCP Option 66 Tag to control updating"
	depends on INCLUDE_OPTION66
	default n

config INCLUDE_OPTION66_LAN
	bool "Enable DHCP Option 66 LAN support. If the switch can not work before cos init, this function will fail."
	depends on INCLUDE_OPTION66
	default n

config INCLUDE_OPTION58
	bool "Enable DHCP Option 58 (T1)"
	default n

config INCLUDE_OPTION59
	bool "Enable DHCP Option 59 (T2)"
	default n

config INCLUDE_DHCP_UNICAST_RENEW
        bool "send unicast renew request"
        default n

config INCLUDE_DHCP_ADDRESS_RESERVE_CONFLICT
	bool "Send DHCP Offer contains another IP if the reserved Static IP is used by other Client"

config INCLUDE_USER_RESTRICTION
	bool "Enable user account permission management"
	depends on INCLUDE_USER_ACCOUNT
	default n
	
config INCLUDE_WEB_AGILECONFIG
