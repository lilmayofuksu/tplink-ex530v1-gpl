config INCLUDE_TTNET_OPTIONS
	bool "TTNET all options (B&C)"
	depends on INCLUDE_TTNET

	######## SELECT Type B ##########
	select INCLUDE_CLI_DIAGNOSIS
	select INCLUDE_FIREWALL_LEVEL
	select INCLUDE_TP_GPIO_BTN_FUNC_CTRL
	select INCLUDE_WEB_TELNET
	select INCLUDE_REMOTE_TELNET
	select INCLUDE_SSH_ACCESS
	select INCLUDE_UPNP_PORTMAP_SWITCH
	select INCLUDE_CWMP_CRPORT_CFGMODE
	select INCLUDE_CWMP_CRPORT_CFGMODE_NEXTBOOT
	select INCLUDE_ROUTE_TBL
	select INCLUDE_ROUTE_TBL_SHOW_ALL_ENTRY
	select INCLUDE_CWMP_DMMAP_PORT_TRIGGER
	select INCLUDE_CWMP_DMMAP_DMZ
	select INCLUDE_FIREWALL_IPFILTER
	select INCLUDE_PACKET_CAPTURE
	select INCLUDE_PKTCAP_UPLOAD
	select INCLUDE_MULTIPORT_FORWARD_VS
	select INCLUDE_MAC_CLIENT_FORWARD_VS
	select INCLUDE_WEB_SECTION
	select INCLUDE_TR143_V1_1_0
	select INCLUDE_LIFEMOTE
	select INCLUDE_USER_DEFAULT_PWD_WARN
	select INCLUDE_CWMP_DMMAP_DEVLOG
	select INCLUDE_DISABLE_ROOT_ACCOUNT_AFTER_UPGRADE
	select INCLUDE_DHCP_OPTION60
	select INCLUDE_AVOID_USE_CWMP_PORT
	select INCLUDE_AVOID_UPNP_USE_CWMP_PORT
	select INCLUDE_CWMP_DEVICE_INFO_MAC_SN
	select INCLUDE_DEV_EXTSTATS
	select INCLUDE_DSL_DIAGNOSTICS
	select INCLUDE_DSL_EXTSTATS
	select INCLUDE_DSL_TESTPARAMS
	select INCLUDE_REDIRECT_REMOTE_HTTP_TO_HTTPS
	select INCLUDE_WIFI_MACFILTER
	select INCLUDE_MACFILTER_SPLIT_2_4G_5G
	select INCLUDE_WEB_WARN
	select INCLUDE_WEB_WARN_WIFI_NOSEC
	select INCLUDE_WRITE_WIFI_PWD
	select INCLUDE_WRITE_MULTI_GUEST_PWD
	select INCLUDE_DISABLE_BROWSER_DEVELOP_TOOL
	select INCLUDE_WAN_CREATOR_RECORD
	select INCLUDE_WPS_ANTI_MISTOUCH
	select INCLUDE_WEB_DISPLAY_PROC_LIST
	select INCLUDE_IGMP_VERSION_SWITCH
	select INCLUDE_DSL_INTERLEAVE_DEPTH
