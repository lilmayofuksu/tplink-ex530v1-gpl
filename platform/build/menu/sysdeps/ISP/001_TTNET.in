########## Define Type C ############
config INCLUDE_TTNET_UPTIME_IPV6
	bool "ipv6 pvc uptime"
	default n
	depends on INCLUDE_TTNET_OPTIONS

config INCLUDE_TTNET_CWMP_DMMAP
	bool "cwmp dmmap use param name of TTNET"
	default n
	depends on INCLUDE_TTNET_OPTIONS

config INCLUDE_TTNET_WEB_HTTP_RESTRICTION
	bool "Admin user cannot configure WAN HTTP"
	default n
	depends on INCLUDE_TTNET_OPTIONS

config INCLUDE_TTNET_IPV6
	bool "TTNET ipv6 nodes for customization(C)"
	default n
	depends on INCLUDE_TTNET_OPTIONS

config INCLUDE_TTNET_DNS_RETRY
	bool "Enable the DNS Retry Mechanism of TTNET"
	default n
	depends on INCLUDE_TTNET_OPTIONS

config INCLUDE_TTNET_HIDE_NECESSARY_WAN_FOR_USER
	bool "Hide Necessary Wan Connect in WebUI for user account, Prevent Them From Being Changed"
	default n
	depends on INCLUDE_TTNET_OPTIONS

config INCLUDE_TTNET_AUTO_CHANGE_CWMP_INTF
	bool "TTNET ACS Route policy"
	default n
	depends on INCLUDE_TTNET_OPTIONS && INCLUDE_WAN_PORT_BINDING
	help
	 CWMP access ACS Server through Internet PVC in DSL mode, through Management(TR069) PVC in EWAN Router mode

config INCLUDE_TTNET_WIFI_HIDE_NO_SECURITY_FOR_USER
	bool "Hide no security option when logged in with user account"
	default n
	depends on INCLUDE_TTNET_OPTIONS && INCLUDE_USER_RESTRICTION

config INCLUDE_TTNET_WIFI_HIDE_WEP_FOR_USER
	bool "Hide WEP option when logged in with user account"
	default n
	depends on INCLUDE_TTNET_OPTIONS && INCLUDE_USER_RESTRICTION

config INCLUDE_TTNET_REINIT_ROOT_PWD
	bool "reinit root password after firmware upgrade"
	default n
	depends on INCLUDE_TTNET_OPTIONS

config INCLUDE_TTNET_WIFI_SSID
	bool "reinit wifi ssid after factory restore"
	default n
	depends on INCLUDE_TTNET_OPTIONS

config INCLUDE_TTNET_EASY_BRIDGE
	bool "easy bridge"
	default n
	depends on INCLUDE_TTNET_OPTIONS

config INCLUDE_TTNET_EASY_LOCAL_ACCESS
	bool "easy local access"
	default n
	depends on INCLUDE_TTNET_OPTIONS

config INCLUDE_TTNET_EASY_REMOTE_ACCESS
	bool "easy remote access"
	default n
	depends on INCLUDE_TTNET_OPTIONS

config INCLUDE_TTNET_HIDE_WANDNS_FOR_USER
	bool "Hide wan dns manual configuration when logged in with user account"
	default n
	depends on INCLUDE_TTNET_OPTIONS && INCLUDE_USER_RESTRICTION

config INCLUDE_TTNET_SYN_DEFAULT_PPPOE
	bool "TTNET Synchronize PPPoE username and password on default"
	default n
	depends on INCLUDE_TTNET_OPTIONS && INCLUDE_WAN_CREATOR_RECORD

config INCLUDE_TTNET_XML_GENERATOR
	bool "Gernerate TTNET xml file"
	default n
	depends on INCLUDE_TTNET_OPTIONS

config INCLUDE_TTNET_WAN_OP_RESTRICTION
	bool "Avoid common user to delete default connections and disable IPTV connections"
	default n
	depends on INCLUDE_TTNET_OPTIONS
	depends on INCLUDE_WAN_CREATOR_RECORD

config INCLUDE_TTNET_RB_CODE
	bool "reboot information record"
	default n
	depends on INCLUDE_TTNET_OPTIONS && INCLUDE_RUNTIME_DATA_SECTION

config INCLUDE_TTNET_FR_CODE
	bool "factory reset information record"
	default n
	depends on INCLUDE_TTNET_OPTIONS && INCLUDE_RUNTIME_DATA_SECTION

config INCLUDE_TTNET_PVC_SPI_FIREWALL
	bool "Add SPI Firewall option in PVC profiles"
	default n
	depends on INCLUDE_TTNET_OPTIONS && INCLUDE_FIREWALL_LEVEL

config INCLUDE_TTNET_QUANT_WIFI
	bool "open quantwifi function"
	default n
	depends on INCLUDE_TTNET_OPTIONS

config INCLUDE_TTNET_UPGRADE_TIME
	bool "After the firewall is successfully upgraded, X_TTG_FwUpgradeTime shoud be updated"
	default n
	depends on INCLUDE_TTNET_OPTIONS

config INCLUDE_TTNET_AUTO_CHANGE_RESERVEDMAC
	bool "When accessmode changed(DSL <-> EWAN), auto change ReservedMAC. After change ReservedMAC CPE will reboot."
	default n
	depends on INCLUDE_TTNET_OPTIONS

config INCLUDE_TTNET_EXT_SYSLOG
	bool "open extra system log of wireless and firewall for TTNET"
	default n
	depends on INCLUDE_TTNET_OPTIONS
