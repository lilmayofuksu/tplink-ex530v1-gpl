	select INCLUDE_QUANTWIFI
	select INCLUDE_INTF_GROUPING 
	select INCLUDE_LAN_VLAN
	select INCLUDE_WIFI_WPS_STOP_ALL_ONCE_SUCC
	# select INCLUDE_SERIAL_SYNC_CMM_ADMIN_ACCOUNT
    select INCLUDE_WAN_REAL_TIME_STATS
	select INCLUDE_GRE
	select INCLUDE_CWMP_SSL_MIN_TLS1_2
	select INCLUDE_HTTP_SSL_MIN_TLS1_2
	select INCLUDE_ACCESS_CTRL_EXT

	######## SELECT Type C ##########
	select INCLUDE_TTNET_UPTIME_IPV6
	select INCLUDE_TTNET_CWMP_DMMAP
	select INCLUDE_TTNET_WEB_HTTP_RESTRICTION
	select INCLUDE_TTNET_DNS_RETRY
	select INCLUDE_TTNET_AUTO_CHANGE_CWMP_INTF
