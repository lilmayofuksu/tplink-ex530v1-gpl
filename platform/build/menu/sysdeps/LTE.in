
menu 'LTE Options'

config INCLUDE_LTEWAN
	bool "Build LTE"
	default n

config INCLUDE_SINGLE_LTEIMAGE
	bool "LTE MODEM UPGRADE"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_LTE_QUECTEL
	bool "Quectel LTE Modem Support"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_USSD
	bool "Build USSD functions"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_DATALIMIT_SMS_ALERT
	bool "Build DATALIMIT_SMS_ALERT"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_LTE_NET_STATISTICS
	bool "Build LTE_NET_STATISTICS"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_LTEWAN_TEST
	bool "Build LTEWAN test utils"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_VOLTE
	bool "Build VoLTE"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_VOLTE_ON_MODEM
	bool "Build VOLTE functions on modem"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_IMS_SWITCH_DEFAULT_OFF
	bool "Build VOLTE Default Value"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_VOLTE_IMS_SWITCH_ON_MODEM
	bool "Build IMS functions on modem"
	depends on INCLUDE_VOLTE_ON_MODEM
	default n

config INCLUDE_LTE_ANTENNA_TYPE
	bool "Choose Internel or External Antenna"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_LTE_ANTENNA_SINGLE_GPIO
	bool "Single GPIO for ANTENNA"
	depends on INCLUDE_LTE_ANTENNA_TYPE
	default n

config INCLUDE_LTE_QMI
	bool "Build QMI FUNCTIONS"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_LTE_RIL
	bool "Build RIL FUNCTIONS"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_LTE_RIL_QUECTEL
	bool "Build QUECTEL RIL FUNCTIONS"
	depends on INCLUDE_LTEWAN && INCLUDE_LTE_RIL
	default n

config INCLUDE_QUECTEL_EG06
	bool "Build QUECTEL EG06 MODEM"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_QUECTEL_EG120K
	bool "Build QUECTEL EG120K MODEM"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_QUECTEL_RG500L
	bool "Build QUECTEL RG500L MODEM"
	depends on INCLUDE_LTEWAN
	default n

