	bool "Build QUECTEL RG520N MODEM"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_QUECTEL_RG520F
	bool "Build QUECTEL RG520F MODEM"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_LTEWAN_TECH_NR5G
	bool "Build NR5G Feature"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_LTE_SEARCH_NET
	bool "Build SEARCH_NET FUNCTIONS"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_LTE_SEARCH_BAND
	bool "Build SEARCH_BAND FUNCTIONS"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_LTE_SUPPORT_QLOG
	bool "Build QLOG FUNCTIONS"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_LTE_SUPPORT_QFIREHOSE
	bool "Build QFIREHOSE FUNCTIONS"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_LTE_SUPPORT_QCM
	bool "Build QCM FUNCTIONS"
	depends on INCLUDE_LTEWAN
