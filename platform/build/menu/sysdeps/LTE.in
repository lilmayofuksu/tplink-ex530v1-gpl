	default n

config INCLUDE_RESTORE_EFS_FACTORY
	bool "Build restore modem efs when reset device"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_LTE_UPGRADE_EDL
	bool "Upgrade 4G/5G module in emergency download mode"
	depends on INCLUDE_LTEWAN
	default n

config INCLUDE_QLOG_ENABLE_BY_TELNET
