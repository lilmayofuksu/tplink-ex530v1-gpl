source menu/sysdeps/ISP/011_ITEO.in
source menu/sysdeps/ISP/012_ITWIND3.in
source menu/sysdeps/ISP/013_WISP_RU.in
source menu/sysdeps/ISP/014_AUTPG.in
source menu/sysdeps/ISP/015_AUVOCUS.in
source menu/sysdeps/ISP/016_PHPLDT.in
source menu/sysdeps/ISP/017_FRBYT.in
source menu/sysdeps/ISP/018_WISP_AU.in
source menu/sysdeps/ISP/019_HKBN.in
source menu/sysdeps/ISP/020_TRTC.in

endmenu
