
#
# Wireless options
#
menu 'Wireless Options'

config INCLUDE_WIFI
	bool "Build wireless"
	default n

config INCLUDE_WIFI_DUALBAND
	bool "Build wifi dual band"
	depends on INCLUDE_WIFI
	default n

config INCLUDE_ACS_WIFI_CONTROL
	bool "Build ACS wifi control"
	depends on INCLUDE_WIFI
	default n

config INCLUDE_WIFI_QRCODE_SHARING
	bool "Build wifi qrcode sharing"
	depends on INCLUDE_WIFI
	default n

config INCLUDE_WIRELESS_UCI
	bool "Build wifi use openwrt uci to set config"
	depends on INCLUDE_WIFI
	default n

config INCLUDE_WIFI_6G
	bool "Build wifi 6G band"
	depends on INCLUDE_WIFI
	default n

choice
	prompt "Wireless Supplier"
	default INCLUDE_WIFI_FAKE
	depends on INCLUDE_WIFI

config INCLUDE_WIFI_MTK
	bool "Build MTK WIFI"
	depends on INCLUDE_WIFI

config INCLUDE_WIFI_RTL
	bool "Build Realtek WIFI"
	depends on INCLUDE_WIFI

config INCLUDE_WIFI_QCA
	bool "Build Qualcomm WIFI"
	depends on INCLUDE_WIFI

config INCLUDE_WIFI_BCM
	bool "Build Broadcom WIFI"
	depends on INCLUDE_WIFI

config INCLUDE_WIFI_LTQ
	bool "Build Lantiq WIFI"
	depends on INCLUDE_WIFI

endchoice

choice
	prompt "WIFI Type - 2.4G"
	default INCLUDE_WIFI_UNKNOW
	depends on INCLUDE_WIFI
	
config WIFI_MTK_2_4G
	bool "Build MTK WIFI as 2.4G"
	depends on INCLUDE_WIFI && INCLUDE_WIFI_MTK
	
config WIFI_QCA_2_4G
	bool "Build QCA WIFI as 2.4G"
	depends on INCLUDE_WIFI && INCLUDE_WIFI_QCA
	
config WIFI_BCM_2_4G
	bool "Build BCM WIFI as 2.4G"
	depends on INCLUDE_WIFI && INCLUDE_WIFI_BCM
	
config WIFI_LTQ_2_4G
	bool "Build LTQ WIFI as 2.4G"
	depends on INCLUDE_WIFI && INCLUDE_WIFI_LTQ

config WIFI_RTL_2_4G
	bool "Build RTL WIFI as 2.4G"
	depends on INCLUDE_WIFI && INCLUDE_WIFI_RTL

endchoice

config WIFI_BCM_WIFI_DHD_2_4G
	bool "2.4G Wifi of BCM is a dongle adapter"
	depends on WIFI_BCM_2_4G
	
config INCLUDE_WIFI_256QAM
	bool "Build 2.4G Wifi with 256QAM"
	depends on WIFI_LTQ_2_4G || WIFI_BCM_2_4G || WIFI_QCA_2_4G || WIFI_RTL_2_4G || WIFI_MTK_2_4G

config BCM_G_BAND_CHIP
	depends on WIFI_BCM_2_4G
	string "G BAND CHIP"
	default "43602"

config WIFI_2G_DRIVER_NAME
	string "2.4G WiFi Driver Module file name"
	default ""

config WIFI_5G_DRIVER_NAME
	depends on INCLUDE_WIFI_DUALBAND 
	string "5G WiFi Driver Module file name"
	default ""

choice
	prompt "WIFI Type - 5G"
	default INCLUDE_WIFI_UNKNOW
	depends on INCLUDE_WIFI && INCLUDE_WIFI_DUALBAND
	
config WIFI_MTK_5G
	bool "Build MTK WIFI as 5G"
	depends on INCLUDE_WIFI_DUALBAND && INCLUDE_WIFI_MTK
	
config WIFI_QCA_5G
	bool "Build QCA WIFI as 5G"
	depends on INCLUDE_WIFI_DUALBAND && INCLUDE_WIFI_QCA
	
config WIFI_BCM_5G
	bool "Build BCM WIFI as 5G"
	depends on INCLUDE_WIFI_DUALBAND && INCLUDE_WIFI_BCM
	
config WIFI_LTQ_5G
	bool "Build LTQ WIFI as 54G"
	depends on INCLUDE_WIFI_DUALBAND && INCLUDE_WIFI_LTQ

config WIFI_RTL_5G
	bool "Build RTL WIFI as 54G"
	depends on INCLUDE_WIFI_DUALBAND && INCLUDE_WIFI_RTL

endchoice

choice
	prompt "WIFI Type - 6G"
	default INCLUDE_WIFI_UNKNOW
	depends on INCLUDE_WIFI && INCLUDE_WIFI_6G

config WIFI_MTK_6G
	bool "Build MTK WIFI as 6G"
	depends on INCLUDE_WIFI_6G && INCLUDE_WIFI_MTK

config WIFI_QCA_6G
	bool "Build QCA WIFI as 6G"
	depends on INCLUDE_WIFI_6G && INCLUDE_WIFI_QCA

config WIFI_BCM_6G
	bool "Build BCM WIFI as 6G"
	depends on INCLUDE_WIFI_6G && INCLUDE_WIFI_BCM

config WIFI_LTQ_6G
	bool "Build LTQ WIFI as 6G"
	depends on INCLUDE_WIFI_6G && INCLUDE_WIFI_LTQ

config WIFI_RTL_6G
	bool "Build LTQ WIFI as 6G"
	depends on INCLUDE_WIFI_6G && INCLUDE_WIFI_RTL

endchoice

config INCLUDE_WIFI_AX_2_4G
	bool "Build wlan 802.11ax on 2.4G Band"
	depends on INCLUDE_WIFI
	default n

config INCLUDE_WIFI_AX_5G
	bool "Build wlan 802.11ax on 5G Band"
	depends on INCLUDE_WIFI_DUALBAND
	default n
	
config INCLUDE_WIFI_WPA3
	bool "Build WPA3-SAE Security for WiFi"
	depends on INCLUDE_WIFI
	default n

config WIFI_BCM_WIFI_DHD_5G
	bool "5G Wifi of BCM is a dongle adapter"
	depends on WIFI_BCM_5G	
	
config BCM_A_BAND_CHIP
	depends on WIFI_BCM_5G
	string "A BAND CHIP"
	default "4366"

config MTK_WIFI_E2PMODE
	depends on INCLUDE_WIFI_MTK
	int "Set mtk wifi e2p mode (0~4, check help for more information)"
	range 0 4
	default 4
	help
		Please input number 0~4 for different e2p mode(default is 4):
		 0 for none
		 1 for efuse
		 2 for flash
		 3 for eeprom
		 4 for bin
		 
config INCLUDE_MTK_7603_ANTI_INTERFERENCE
	bool "Anti-interference optimization for MTK 7603"
	default n
	depends on INCLUDE_WIFI_MTK

config INCLUDE_WIFI_MTK_MT7986
	bool "Using WIFI MTK MT7986"
	default n
	depends on INCLUDE_WIFI_MTK

config INCLUDE_WIFI_MTK_MT7916D
	bool "Using ECONET Merlin Chip MT7916"
	default n
	depends on INCLUDE_WIFI_MTK
	
config INCLUDE_REAL_NAME_WL_5G_MAIN
	string "Wifi 5G Interface Real Name - Main"
	default "wl0" if WIFI_BCM_5G
	default "rai0" if WIFI_MTK_5G
	default "ath5" if WIFI_QCA_5G
	default "wlan0" if WIFI_RTL_5G

config INCLUDE_REAL_NAME_WL_5G_WDS
	string "Wifi 5G Interface Real Name - WDS"
	default "wl0" if WIFI_BCM_5G
	default "apclii0" if WIFI_MTK_5G
	default "ath6" if WIFI_QCA_5G
	default "wlan0-vxd" if WIFI_RTL_5G

