menu 'Data Model Specific Options'

config INCLUDE_DATA_MODEL_SPEC_OPTIONS
	bool "data model specific options support"
	default n

config DEV2_WIFI_RADIO_MAX_INST
	int "max instance of Device.WiFi.Radio.{i}."
	default 2
	depends on INCLUDE_DATA_MODEL_SPEC_OPTIONS
	help
	  You have to modify reduced_data_model.xml in directory of model if this config is enabled.
	  And the max instance for this MACRO and value in reduced_data_model.xml must be the same!

config WIFI_RADIO_STATS_MAX_INST
