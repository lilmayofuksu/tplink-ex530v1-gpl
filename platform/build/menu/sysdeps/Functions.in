config INCLUDE_ADVANCED_FIREWALL_LOG
	bool "Build advanced firewall log support"
	default n
	depends on INCLUDE_ADVANCED_FIREWALL
	help
	   Build fwlogd, collect firewall log from kernel,
	   send to cmmsyslogd and show on system log of web.

config INCLUDE_ADVANCED_FIREWALL_LOG_MARK
	string "Mark added before origin firewall log"
	default "1F1W4L5O1G4"
	depends on INCLUDE_ADVANCED_FIREWALL_LOG
	help
	   We add mark in front of the origin firewall log,
	   and we also filter out firewall log from kmsg through the mark.

config INCLUDE_ADVANCED_FIREWALL_LOG_SHM_LEN
	int "Length of share memory to save firewall log(unit: 1kB)"
	default 32
	depends on INCLUDE_ADVANCED_FIREWALL_LOG
	help
	   Firewall logs will be send to cmmsyslog,
	   need a new space to save them because of overlapping.

config INCLUDE_ADVANCED_FIREWALL_LOG_SPEED_MIN
	int "Min speed of firewall rule log"
	default 1
	depends on INCLUDE_ADVANCED_FIREWALL_LOG
	help
	   Min speed of firewall rule log. It should more than 0.
	   Speed unit depends on user input, it can be per second, per minute and per hour.

config INCLUDE_ADVANCED_FIREWALL_LOG_SPEED_MAX
	int "Max speed of firewall rule log"
	default 360000
	depends on INCLUDE_ADVANCED_FIREWALL_LOG
	help
	   Max speed of firewall rule log. It should less than or equal to 360000.
	   Speed unit depends on user input, it can be per second, per minute and per hour.

