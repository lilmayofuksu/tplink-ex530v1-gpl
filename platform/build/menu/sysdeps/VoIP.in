	bool "United Kindom"
	depends on VOIP_LOCALE_CUSTOM

endmenu  # menu "VOIP locale support"

config INCLUDE_AGINET_APP_VOIP
	depends on INCLUDE_VOIP
	bool "Agient app support voip"
	default n

config INCLUDE_AGINET_APP_USB_VOICEMAIL
	depends on INCLUDE_VOIP && INCLUDE_USB_VOICEMAIL
	bool "Agient app support voicemail"
	default n

config INCLUDE_AGINET_APP_VOIP_DECT
	depends on INCLUDE_AGINET_APP_VOIP
	bool "Agient app support dect"
	default n

config INCLUDE_AGINET_APP_HIDE_VOIP_WAN
	depends on INCLUDE_AGINET_APP_VOIP
	bool "Hide app voip wan setting"
	default n

config INCLUDE_AGINET_APP_HIDE_VOIP_VOICE_MAIL
	depends on INCLUDE_AGINET_APP_VOIP
	bool "Hide app voip voice mail"
	default n

config INCLUDE_AGINET_APP_HIDE_VOIP_FIRST_GUIDE
	depends on INCLUDE_AGINET_APP_VOIP
	bool "Hide app voip first guide"
	default n

config INCLUDE_AGINET_APP_HIDE_VOIP_TELEPHONE_DEVICE
	depends on INCLUDE_AGINET_APP_VOIP
	bool "Hide app voip telephone device"
	default n

config INCLUDE_AGINET_APP_HIDE_VOIP_CALL_LOG
	depends on INCLUDE_AGINET_APP_VOIP
	bool "Hide app voip call log"
	default n

config INCLUDE_AGINET_APP_HIDE_VOIP_CALL_FORWARD
	depends on INCLUDE_AGINET_APP_VOIP
	bool "Hide app voip call forward"
	default n

config INCLUDE_AGINET_APP_HIDE_VOIP_DND
	depends on INCLUDE_AGINET_APP_VOIP
	bool "Hide app voip do not disturb"
	default n

config INCLUDE_AGINET_APP_HIDE_VOIP_CALL_BLOCKING
	depends on INCLUDE_AGINET_APP_VOIP
	bool "Hide app voip call blocking"
	default n

endmenu	# menu 'VoIP Options'
